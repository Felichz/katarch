---
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title: string;
  description: string;
  lang?: 'es' | 'en';
}

const { title, description, lang = 'es' } = Astro.props;
const isEnglish = lang === 'en';
---

<!doctype html>
<html lang={lang} class="dark scroll-smooth overflow-x-clip">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ViewTransitions />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Courier+Prime:ital,wght@0,400;0,700;1,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;0,8..60,800;1,8..60,400&display=swap" rel="stylesheet">

    <!-- Theme Script: Defaults to Dark unless explicitly set to Light -->
    <script is:inline>
      const storedTheme = localStorage.getItem('theme');
      if (storedTheme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="site-body">
    <!--
      THESIS: one chronological walkthrough of a real architecture case, formatted
      as the audience's native document: a numbered engineering memo. Refuses the
      docs-template and the terminal-neon looks this category ships.
      OWN-WORLD: laid-paper memo. Typewriter (Courier Prime) carries the document
      apparatus (masthead, § numbers, gutter numerals, errata labels); Source
      Serif 4 carries the reading; one reference-blue accent; hairline rules.
      Dark mode is the same memo on a lamp-lit desk.
      STORY: the visitor reads a decision memo where every claim stays traceable:
      numbered paragraphs, doc cards as citation apparatus, decisions as status
      blocks, callouts as errata.
      FIRST VIEWPORT: slim document band (wordmark + doc id + ES/EN + lamp), memo
      masthead fields, two-tone ink/blue serif title, body flowing in a numbered
      gutter column.
      FORM: replacement world (impeccable new-work roll a0855f1c, assigned
      direction 5 of the grounded list, mode Read).
      FINISH: unreviewed and undocumented is unfinished; this build ends with the
      finish review, the verdict, and DESIGN.md.
    -->

    <!-- Reading position: one ink rule filling across the band -->
    <div id="progress-bar" aria-hidden="true"></div>

    <!-- Document band -->
    <header class="doc-band">
      <div class="doc-band-inner">
        <div class="doc-brand">
          <a href={isEnglish ? '/es' : '/'} class="doc-wordmark">
            KatArch
          </a>
          <span class="doc-sep" aria-hidden="true">·</span>
          <span class="doc-id">MEMO KATA/2020-FALL</span>
        </div>

        <div class="doc-controls">
          <a href="https://github.com/TheKataLog" target="_blank" rel="noopener noreferrer" class="doc-link">
            <span class="doc-link-label">{isEnglish ? 'Repos' : 'Repositorios'}</span>
            <svg class="doc-link-arrow" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
          </a>

          <a
            href={isEnglish ? '/es' : '/'}
            class="lang-switch"
            title={isEnglish ? 'Cambiar a Español' : 'Switch to English'}
            aria-label={isEnglish ? 'Cambiar a Español' : 'Switch to English'}
          >
            <span class={!isEnglish ? 'is-on' : ''}>ES</span>
            <span class="lang-sep" aria-hidden="true">/</span>
            <span class={isEnglish ? 'is-on' : ''}>EN</span>
          </a>

          <button
            id="theme-toggle"
            type="button"
            class="lamp-toggle"
            aria-label={isEnglish ? 'Toggle between light and dark mode' : 'Cambiar entre tema claro y oscuro'}
            title={isEnglish ? 'Toggle theme (Light / Dark)' : 'Cambiar tema (Claro / Oscuro)'}
          >
            <svg id="theme-icon-sun" class="tgl-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" d="M12 3v1m0 16v1m9-9h-1M4 9H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
            <svg id="theme-icon-moon" class="tgl-icon tgl-hidden" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
            <span id="theme-label" data-lang={lang}>{isEnglish ? 'Dark' : 'Oscuro'}</span>
          </button>
        </div>
      </div>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <!-- Colophon -->
    <footer class="doc-colophon">
      <div class="colophon-inner">
        <p class="colophon-line">
          {isEnglish
            ? 'Comparative pedagogical analysis of real-world production architectures from the first O\u2019Reilly Software Architecture Kata.'
            : 'An\u00e1lisis pedag\u00f3gico comparado de soluciones reales del primer O\u2019Reilly Software Architecture Kata.'}
        </p>
        <p class="colophon-line">
          {isEnglish ? 'Theoretical framework: ' : 'Marco te\u00f3rico: '}
          <span class="colophon-em">Fundamentals of Software Architecture</span> (Mark Richards &amp; Neal Ford).
        </p>
      </div>
    </footer>

    <!-- Scripts: Reading Progress + Theme Toggle.
         Runs under Astro's ClientRouter (the ES/EN switch swaps the page
         without a reload): the scroll listener is window-level (survives
         swaps), and per-page bindings re-run on every astro:page-load. -->
    <script>
      // Reading progress bar: the handler re-queries the bar element, so it
      // keeps working after the swap replaces it.
      window.addEventListener('scroll', () => {
        const winScroll = document.documentElement.scrollTop;
        const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const scrolled = (winScroll / height) * 100;
        const bar = document.getElementById('progress-bar');
        if (bar) bar.style.width = scrolled + '%';
      });

      function applyStoredTheme() {
        // The swap restores the server-rendered <html> class; put the stored
        // theme back immediately so light-mode users see no dark flash.
        const storedTheme = localStorage.getItem('theme');
        document.documentElement.classList.toggle('dark', storedTheme !== 'light');
      }

      function syncThemeUI() {
        const sunIcon = document.getElementById('theme-icon-sun');
        const moonIcon = document.getElementById('theme-icon-moon');
        const themeLabel = document.getElementById('theme-label');
        const isEn = themeLabel?.getAttribute('data-lang') === 'en';
        const isDark = document.documentElement.classList.contains('dark');
        if (isDark) {
          sunIcon?.classList.remove('tgl-hidden');
          moonIcon?.classList.add('tgl-hidden');
          if (themeLabel) themeLabel.textContent = isEn ? 'Dark' : 'Oscuro';
        } else {
          sunIcon?.classList.add('tgl-hidden');
          moonIcon?.classList.remove('tgl-hidden');
          if (themeLabel) themeLabel.textContent = isEn ? 'Light' : 'Claro';
        }
      }

      function bindThemeToggle() {
        applyStoredTheme();
        syncThemeUI();
        document.getElementById('theme-toggle')?.addEventListener('click', () => {
          const isDark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
          syncThemeUI();
        });
      }

      window.addEventListener('astro:after-swap', applyStoredTheme);
      document.addEventListener('astro:page-load', bindThemeToggle);
    </script>
  </body>
</html>

<style is:global>
  /* ── The memo world: tokens ─────────────────────────────
     Light = laid paper on a desk. Dark = the same memo under a lamp. */
  :root {
    --paper: #f4efe3;
    --paper-raised: #fbf8ee;
    --paper-deep: #ede7d6;
    --ink: #241f14;
    --ink-2: #6e6651;
    --ink-3: #7d7460;
    --rule: #d8cfb6;
    --hairline: #c6bb9e;
    --accent: #1e42a8;
    --accent-strong: #16307d;
    --accent-wash: #e6e5f2;
    --amber: #8a4d08;
    --amber-wash: #f2e6cb;
    --shadow-lift: 0 1px 2px rgb(36 31 20 / 0.08), 0 6px 24px rgb(36 31 20 / 0.07);
  }
  .dark {
    --paper: #161310;
    --paper-raised: #1f1b15;
    --paper-deep: #29241b;
    --ink: #e9e1cb;
    --ink-2: #b1a78d;
    --ink-3: #8d8368;
    --rule: #3a3428;
    --hairline: #484130;
    --accent: #a3b8f3;
    --accent-strong: #c8d4f9;
    --accent-wash: #232733;
    --amber: #dca75f;
    --amber-wash: #2b2317;
    --shadow-lift: 0 1px 2px rgb(0 0 0 / 0.4), 0 10px 32px rgb(0 0 0 / 0.35);
  }

  html { background: var(--paper); }
  body {
    font-family: 'Source Serif 4', Georgia, serif;
    background: var(--paper);
    color: var(--ink);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  ::selection { background: var(--accent-wash); color: var(--ink); }
  .mono, code, pre { font-family: 'Courier Prime', 'Courier New', monospace; }

  /* Pro dark scrollbars tuned to the desk */
  .dark ::-webkit-scrollbar { width: 6px; height: 6px; }
  .dark ::-webkit-scrollbar-track { background: transparent; }
  .dark ::-webkit-scrollbar-thumb { background: var(--hairline); border-radius: 9999px; }
  .dark ::-webkit-scrollbar-thumb:hover { background: var(--ink-3); }

  /* ── Reading position rule ─────────────────────────── */
  #progress-bar {
    position: fixed;
    top: 0; left: 0;
    height: 2px;
    width: 0;
    background: var(--accent);
    z-index: 100;
    transition: width 75ms linear;
  }

  /* ── Document band ─────────────────────────────────── */
  .doc-band {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
  }
  .doc-band-inner {
    max-width: 82rem;
    margin: 0 auto;
    padding: 0 1.25rem;
    height: 3.4rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .doc-brand { display: flex; align-items: baseline; gap: 0.6rem; min-width: 0; }
  .doc-wordmark {
    font-family: 'Courier Prime', monospace;
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 0.02em;
    color: var(--ink);
    text-decoration: none;
  }
  .doc-wordmark:hover { color: var(--accent); }
  .doc-sep { color: var(--ink-3); }
  .doc-id {
    font-family: 'Courier Prime', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--ink-2);
    white-space: nowrap;
  }
  .doc-controls { display: flex; align-items: center; gap: 1rem; }
  .doc-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: 'Courier Prime', monospace;
    font-size: 0.8rem;
    color: var(--ink-2);
    text-decoration: none;
  }
  .doc-link:hover { color: var(--accent); }
  @media (max-width: 40rem) {
    .doc-link-label { display: none; }
    .doc-id { white-space: normal; font-size: 0.66rem; }
  }

  .lang-switch {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    font-family: 'Courier Prime', monospace;
    font-size: 0.8rem;
    color: var(--ink-2);
    text-decoration: none;
    padding: 0.3rem 0.5rem;
    border: 1px solid var(--rule);
    border-radius: 2px;
  }
  .lang-switch:hover { border-color: var(--hairline); color: var(--ink-2); }
  .lang-switch .is-on { color: var(--accent); font-weight: 700; }
  .lang-sep { color: var(--ink-3); opacity: 0.6; }

  .lamp-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: 'Courier Prime', monospace;
    font-size: 0.8rem;
    color: var(--ink-2);
    background: none;
    border: 1px solid var(--rule);
    border-radius: 2px;
    padding: 0.3rem 0.55rem;
    cursor: pointer;
  }
  .lamp-toggle:hover { color: var(--ink); border-color: var(--hairline); }
  .lamp-toggle .tgl-hidden { display: none; }
  #theme-icon-sun { color: var(--amber); }
  #theme-icon-moon { color: var(--ink-2); }

  /* ── Main / colophon ───────────────────────────────── */
  .site-main { width: 100%; flex: 1; min-width: 0; padding: 2.5rem 1.25rem 0; }
  .doc-colophon {
    margin-top: 5rem;
    border-top: 1px solid var(--rule);
    background: var(--paper);
    padding: 2.2rem 1.25rem;
  }
  .colophon-inner {
    max-width: 48rem;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .colophon-line {
    font-family: 'Courier Prime', monospace;
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .colophon-em { color: var(--ink); font-weight: 700; }
</style>
