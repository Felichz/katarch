---
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title: string;
  description: string;
  lang?: 'es' | 'en';
}

const { title, description, lang = 'es' } = Astro.props;
const isEnglish = lang === 'en';
---

<!doctype html>
<html lang={lang} class="dark scroll-smooth overflow-x-clip">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ViewTransitions />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;700;800&family=Allerta+Stencil&family=Barlow+Condensed:wght@400;600;700&family=Cardo:ital,wght@0,400;0,700;1,400&family=Courier+Prime:ital,wght@0,400;0,700;1,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;0,8..60,800;1,8..60,400&display=swap" rel="stylesheet">

    <!-- Theme Script: Defaults to Dark unless explicitly set to Light -->
    <script is:inline>
      const storedTheme = localStorage.getItem('theme');
      if (storedTheme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
      try {
        document.documentElement.dataset.world = localStorage.getItem('katarch-world') || 'memo';
      } catch {
        document.documentElement.dataset.world = 'memo';
      }
    </script>
  </head>
  <body class="site-body">
    <!--
      THESIS: one chronological walkthrough of a real architecture case, formatted
      as the audience's native document: a numbered engineering memo. Refuses the
      docs-template and the terminal-neon looks this category ships.
      OWN-WORLD: laid-paper memo. Typewriter (Courier Prime) carries the document
      apparatus (masthead, § numbers, gutter numerals, errata labels); Source
      Serif 4 carries the reading; one reference-blue accent; hairline rules.
      Dark mode is the same memo on a lamp-lit desk.
      STORY: the visitor reads a decision memo where every claim stays traceable:
      numbered paragraphs, doc cards as citation apparatus, decisions as status
      blocks, callouts as errata.
      FIRST VIEWPORT: slim document band (wordmark + doc id + ES/EN + lamp), memo
      masthead fields, two-tone ink/blue serif title, body flowing in a numbered
      gutter column.
      FORM: replacement world (impeccable new-work roll a0855f1c, assigned
      direction 5 of the grounded list, mode Read).
      FINISH: unreviewed and undocumented is unfinished; this build ends with the
      finish review, the verdict, and DESIGN.md.
    -->

    <!-- Reading position: one ink rule filling across the band -->
    <div id="progress-bar" aria-hidden="true"></div>

    <!-- Document band -->
    <header class="doc-band">
      <div class="doc-band-inner">
        <div class="doc-brand">
          <a href={isEnglish ? '/es' : '/'} class="doc-wordmark">
            KatArch
          </a>
          <span class="doc-sep" aria-hidden="true">·</span>
          <span class="doc-id">MEMO KATA/2020-FALL</span>
        </div>

        <div class="doc-controls">
          <a href="https://github.com/TheKataLog" target="_blank" rel="noopener noreferrer" class="doc-link">
            <span class="doc-link-label">{isEnglish ? 'Repos' : 'Repositorios'}</span>
            <svg class="doc-link-arrow" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
          </a>

          <select class="world-select" data-world-select aria-label={isEnglish ? 'Visual style' : 'Estilo visual'}>
            <option value="memo">{isEnglish ? 'Standards memo' : 'Memo de estándares'}</option>
            <option value="botteghe">{isEnglish ? 'Quarterly on blue' : 'Revista sobre mesa azul'}</option>
            <option value="bench">{isEnglish ? 'Cutting bench' : 'Mesa de montaje'}</option>
            <option value="plate">{isEnglish ? 'Industrial plate' : 'Placa industrial'}</option>
          </select>

          <a
            href={isEnglish ? '/es' : '/'}
            class="lang-switch"
            title={isEnglish ? 'Cambiar a Español' : 'Switch to English'}
            aria-label={isEnglish ? 'Cambiar a Español' : 'Switch to English'}
          >
            <span class={!isEnglish ? 'is-on' : ''}>ES</span>
            <span class="lang-sep" aria-hidden="true">/</span>
            <span class={isEnglish ? 'is-on' : ''}>EN</span>
          </a>

          <button
            id="theme-toggle"
            type="button"
            class="lamp-toggle"
            aria-label={isEnglish ? 'Toggle between light and dark mode' : 'Cambiar entre tema claro y oscuro'}
            title={isEnglish ? 'Toggle theme (Light / Dark)' : 'Cambiar tema (Claro / Oscuro)'}
          >
            <svg id="theme-icon-sun" class="tgl-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" d="M12 3v1m0 16v1m9-9h-1M4 9H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
            <svg id="theme-icon-moon" class="tgl-icon tgl-hidden" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
            <span id="theme-label" data-lang={lang}>{isEnglish ? 'Dark' : 'Oscuro'}</span>
          </button>
        </div>
      </div>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <!-- Colophon -->
    <footer class="doc-colophon">
      <div class="colophon-inner">
        <p class="colophon-line">
          {isEnglish
            ? 'Comparative pedagogical analysis of real-world production architectures from the first O\u2019Reilly Software Architecture Kata.'
            : 'An\u00e1lisis pedag\u00f3gico comparado de soluciones reales del primer O\u2019Reilly Software Architecture Kata.'}
        </p>
        <p class="colophon-line">
          {isEnglish ? 'Theoretical framework: ' : 'Marco te\u00f3rico: '}
          <span class="colophon-em">Fundamentals of Software Architecture</span> (Mark Richards &amp; Neal Ford).
        </p>
      </div>
    </footer>

    <!-- Scripts: Reading Progress + Theme Toggle.
         Runs under Astro's ClientRouter (the ES/EN switch swaps the page
         without a reload): the scroll listener is window-level (survives
         swaps), and per-page bindings re-run on every astro:page-load. -->
    <script>
      // Reading progress bar: the handler re-queries the bar element, so it
      // keeps working after the swap replaces it.
      window.addEventListener('scroll', () => {
        const winScroll = document.documentElement.scrollTop;
        const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const scrolled = (winScroll / height) * 100;
        const bar = document.getElementById('progress-bar');
        if (bar) bar.style.width = scrolled + '%';
      });

      function applyStoredTheme() {
        // The swap restores the server-rendered <html> class; put the stored
        // theme back immediately so light-mode users see no dark flash.
        const storedTheme = localStorage.getItem('theme');
        document.documentElement.classList.toggle('dark', storedTheme !== 'light');
      }

      function syncThemeUI() {
        const sunIcon = document.getElementById('theme-icon-sun');
        const moonIcon = document.getElementById('theme-icon-moon');
        const themeLabel = document.getElementById('theme-label');
        const isEn = themeLabel?.getAttribute('data-lang') === 'en';
        const isDark = document.documentElement.classList.contains('dark');
        if (isDark) {
          sunIcon?.classList.remove('tgl-hidden');
          moonIcon?.classList.add('tgl-hidden');
          if (themeLabel) themeLabel.textContent = isEn ? 'Dark' : 'Oscuro';
        } else {
          sunIcon?.classList.add('tgl-hidden');
          moonIcon?.classList.remove('tgl-hidden');
          if (themeLabel) themeLabel.textContent = isEn ? 'Light' : 'Claro';
        }
      }

      function bindThemeToggle() {
        applyStoredTheme();
        syncThemeUI();
        document.getElementById('theme-toggle')?.addEventListener('click', () => {
          const isDark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
          syncThemeUI();
        });
      }

      function applyStoredWorld() {
        let w = 'memo';
        try {
          w = localStorage.getItem('katarch-world') || 'memo';
        } catch {
          /* keep memo */
        }
        document.documentElement.dataset.world = w;
      }

      function bindWorldSelect() {
        const sel = document.querySelector('[data-world-select]');
        if (!sel) return;
        sel.value = document.documentElement.dataset.world || 'memo';
        sel.addEventListener('change', () => {
          document.documentElement.dataset.world = sel.value;
          try {
            localStorage.setItem('katarch-world', sel.value);
          } catch {
            /* stays per page */
          }
        });
      }

      window.addEventListener('astro:after-swap', () => {
        applyStoredTheme();
        applyStoredWorld();
      });
      document.addEventListener('astro:page-load', () => {
        bindThemeToggle();
        bindWorldSelect();
      });
    </script>
  </body>
</html>

<style is:global>
  /* ── The memo world: tokens ─────────────────────────────
     Light = laid paper on a desk. Dark = the same memo under a lamp. */
    /* World tokens: memo (default), botteghe, bench, plate */
  [data-world="memo"] {
    --font-body: 'Source Serif 4', Georgia, serif;
    --font-app: 'Courier Prime', 'Courier New', monospace;
    --hard-shadow: transparent;
    --paper: #f4efe3;
    --paper-raised: #fbf8ee;
    --paper-deep: #ede7d6;
    --ink: #241f14;
    --ink-2: #6e6651;
    --ink-3: #7d7460;
    --rule: #d8cfb6;
    --hairline: #c6bb9e;
    --accent: #1e42a8;
    --accent-strong: #16307d;
    --accent-wash: #e6e5f2;
    --amber: #8a4d08;
    --amber-wash: #f2e6cb;
    --shadow-lift: 0 1px 2px rgb(36 31 20 / 0.08), 0 6px 24px rgb(36 31 20 / 0.07);
  }
  .dark[data-world="memo"] {
    --paper: #161310;
    --paper-raised: #1f1b15;
    --paper-deep: #29241b;
    --ink: #e9e1cb;
    --ink-2: #b1a78d;
    --ink-3: #8d8368;
    --rule: #3a3428;
    --hairline: #484130;
    --accent: #a3b8f3;
    --accent-strong: #c8d4f9;
    --accent-wash: #232733;
    --amber: #dca75f;
    --amber-wash: #2b2317;
    --shadow-lift: 0 1px 2px rgb(0 0 0 / 0.4), 0 10px 32px rgb(0 0 0 / 0.35);
  }

  /* Botteghe: a literary quarterly's leaf on an oltremare ground.
     The ground shows on all sides; the leaf carries the ink. */
  [data-world="botteghe"] {
    --font-body: 'Cardo', Georgia, serif;
    --font-app: 'Cardo', Georgia, serif;
    --hard-shadow: transparent;
    --paper: #12305e;
    --paper-raised: #f6f1e2;
    --paper-deep: #ece5d0;
    --ink: #221d11;
    --ink-2: #544c38;
    --ink-3: #7c7259;
    --rule: #d9d0b8;
    --hairline: #c8bd9f;
    --accent: #bf3b1f;
    --accent-strong: #962c15;
    --accent-wash: #f3ddd2;
    --amber: #8a4d08;
    --amber-wash: #f2e6cb;
    --shadow-lift: 0 18px 50px rgb(4 12 30 / 0.5);
  }
  [data-world="botteghe"].dark {
    --paper: #081a3a;
    --shadow-lift: 0 22px 60px rgb(0 0 0 / 0.65);
  }

  /* Bench: a film cutting bench. True black, flag orange, one condensed
     grotesk; running copy sits in punched cream windows; sections hang
     from a perforated rail. The bench is the same under any lamp. */
  [data-world="bench"], [data-world="bench"].dark {
    --font-body: 'Barlow Condensed', 'Arial Narrow', sans-serif;
    --font-app: 'Barlow Condensed', 'Arial Narrow', sans-serif;
    --hard-shadow: transparent;
    --paper: #050505;
    --paper-raised: #f3ead8;
    --paper-deep: #111111;
    --ink: #f3ead8;
    --ink-2: #cfc6b2;
    --ink-3: #8f8875;
    --rule: #2b2b2b;
    --hairline: #3c3c3c;
    --accent: #ff6a1a;
    --accent-strong: #ffa25e;
    --accent-wash: #1c120a;
    --amber: #ff6a1a;
    --amber-wash: #1c120a;
    --shadow-lift: 0 0 0 1px #050505;
    --window-bg: #f3ead8;
    --window-ink: #17130d;
  }

  /* Plate: precisionist. Chalk ground, slate ink, rust accent, flat
     planes with one hard shadow, stencil numerals. */
  [data-world="plate"] {
    --font-body: 'Archivo', 'Helvetica Neue', sans-serif;
    --font-app: 'Archivo', 'Helvetica Neue', sans-serif;
    --paper: #f2f0ea;
    --paper-raised: #fbfaf7;
    --paper-deep: #e7e4dc;
    --ink: #2b313c;
    --ink-2: #565e6c;
    --ink-3: #79818f;
    --rule: #c9ccd2;
    --hairline: #b6bac2;
    --accent: #b04a24;
    --accent-strong: #8c3818;
    --accent-wash: #f0e0d8;
    --amber: #8a4d08;
    --amber-wash: #f2e6cb;
    --shadow-lift: none;
    --hard-shadow: #2b313c;
  }
  [data-world="plate"].dark {
    --paper: #1b2027;
    --paper-raised: #242b34;
    --paper-deep: #2d3540;
    --ink: #e8ebee;
    --ink-2: #b4bbc6;
    --ink-3: #8d95a2;
    --rule: #3a424e;
    --hairline: #4a5361;
    --accent: #d8663c;
    --accent-strong: #e88a63;
    --accent-wash: #33231d;
    --hard-shadow: #0a0d12;
  }

  html { background: var(--paper); }
  body {
    font-family: var(--font-body);
    background: var(--paper);
    color: var(--ink);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  ::selection { background: var(--accent-wash); color: var(--ink); }
  .mono, code, pre { font-family: var(--font-app); }

  /* Pro dark scrollbars tuned to the desk */
  .dark ::-webkit-scrollbar { width: 6px; height: 6px; }
  .dark ::-webkit-scrollbar-track { background: transparent; }
  .dark ::-webkit-scrollbar-thumb { background: var(--hairline); border-radius: 9999px; }
  .dark ::-webkit-scrollbar-thumb:hover { background: var(--ink-3); }

  /* ── Reading position rule ─────────────────────────── */
  #progress-bar {
    position: fixed;
    top: 0; left: 0;
    height: 2px;
    width: 0;
    background: var(--accent);
    z-index: 100;
    transition: width 75ms linear;
  }

  /* ── Document band ─────────────────────────────────── */
  .doc-band {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
  }
  .doc-band-inner {
    max-width: 82rem;
    margin: 0 auto;
    padding: 0 1.25rem;
    height: 3.4rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .doc-brand { display: flex; align-items: baseline; gap: 0.6rem; min-width: 0; }
  .doc-wordmark {
    font-family: 'Courier Prime', monospace;
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 0.02em;
    color: var(--ink);
    text-decoration: none;
  }
  .doc-wordmark:hover { color: var(--accent); }
  .doc-sep { color: var(--ink-3); }
  .doc-id {
    font-family: 'Courier Prime', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--ink-2);
    white-space: nowrap;
  }
  .doc-controls { display: flex; align-items: center; gap: 1rem; }
  .doc-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: 'Courier Prime', monospace;
    font-size: 0.8rem;
    color: var(--ink-2);
    text-decoration: none;
  }
  .doc-link:hover { color: var(--accent); }
  @media (max-width: 40rem) {
    .doc-link-label { display: none; }
    .doc-id { white-space: normal; font-size: 0.66rem; }
  }

  .lang-switch {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    font-family: 'Courier Prime', monospace;
    font-size: 0.8rem;
    color: var(--ink-2);
    text-decoration: none;
    padding: 0.3rem 0.5rem;
    border: 1px solid var(--rule);
    border-radius: 2px;
  }
  .lang-switch:hover { border-color: var(--hairline); color: var(--ink-2); }
  .lang-switch .is-on { color: var(--accent); font-weight: 700; }
  .lang-sep { color: var(--ink-3); opacity: 0.6; }

  .lamp-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: 'Courier Prime', monospace;
    font-size: 0.8rem;
    color: var(--ink-2);
    background: none;
    border: 1px solid var(--rule);
    border-radius: 2px;
    padding: 0.3rem 0.55rem;
    cursor: pointer;
  }
  .lamp-toggle:hover { color: var(--ink); border-color: var(--hairline); }
  .lamp-toggle .tgl-hidden { display: none; }
  #theme-icon-sun { color: var(--amber); }
  #theme-icon-moon { color: var(--ink-2); }

  .world-select {
    font-family: var(--font-app);
    font-size: 0.78rem;
    color: var(--ink-2);
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: 2px;
    padding: 0.28rem 0.4rem;
    cursor: pointer;
    max-width: 13rem;
  }
  .world-select:hover { border-color: var(--hairline); color: var(--ink); }
  .world-select:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  /* ── Main / colophon ───────────────────────────────── */
  .site-main { width: 100%; flex: 1; min-width: 0; padding: 2.5rem 1.25rem 0; }
  .doc-colophon {
    margin-top: 5rem;
    border-top: 1px solid var(--rule);
    background: var(--paper);
    padding: 2.2rem 1.25rem;
  }
  .colophon-inner {
    max-width: 48rem;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .colophon-line {
    font-family: 'Courier Prime', monospace;
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .colophon-em { color: var(--ink); font-weight: 700; }

  /* == Per-world composition overrides ================================ */

  /* Botteghe: leaf on the ground */
  [data-world="botteghe"] .site-main { padding-top: 3.5rem; padding-bottom: 3.5rem; }
  [data-world="botteghe"] .article {
    background: var(--paper-raised);
    padding: clamp(2.5rem, 5vw, 4.5rem);
    box-shadow: var(--shadow-lift);
    border-radius: 2px;
  }
  [data-world="botteghe"] .hero-prose,
  [data-world="botteghe"] .article .set-prose,
  [data-world="botteghe"] .article .block-list { max-width: none; }
  [data-world="botteghe"] .doc-band,
  [data-world="botteghe"] .doc-colophon {
    --ink: #e8e2cf;
    --ink-2: #b9c0d4;
    --ink-3: #8f97ad;
    --rule: rgb(232 226 207 / 0.25);
    --hairline: rgb(232 226 207 / 0.35);
    --accent: #e8745a;
  }
  [data-world="botteghe"] .toc-rail {
    --paper-deep: rgb(232 226 207 / 0.12);
    --ink: #e8e2cf;
    --ink-2: #b9c0d4;
    --ink-3: #8f97ad;
    --rule: rgb(232 226 207 / 0.25);
    --paper-raised: transparent;
    --accent: #e8745a;
    --accent-wash: rgb(232 116 90 / 0.15);
  }
  [data-world="botteghe"] .toc-card { border-color: transparent; background: transparent; }
  [data-world="botteghe"] .memo-masthead {
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--accent);
    border-radius: 0;
    padding-left: 0;
    padding-right: 0;
  }
  [data-world="botteghe"] .mast-key, [data-world="botteghe"] .doc-id,
  [data-world="botteghe"] .block-card .tag, [data-world="botteghe"] .tbl-caption,
  [data-world="botteghe"] .decision-card dt, [data-world="botteghe"] .cd-title,
  [data-world="botteghe"] .cd-col-title, [data-world="botteghe"] .closing-title,
  [data-world="botteghe"] .figure-guide-kicker, [data-world="botteghe"] .block-callout h4 {
    font-variant-caps: all-small-caps;
    letter-spacing: 0.14em;
  }
  [data-world="botteghe"] .section-title::before { font-size: 0.85em; vertical-align: 0.15em; }
  [data-world="botteghe"] .doc-wordmark, [data-world="botteghe"] .doc-link,
  [data-world="botteghe"] .lamp-toggle, [data-world="botteghe"] .world-select,
  [data-world="botteghe"] .lang-switch { font-variant-caps: all-small-caps; }

  /* Bench: punched windows on black, perforated rail */
  [data-world="bench"] body, [data-world="bench"].dark body { background: #050505; }
  [data-world="bench"] .hero-prose,
  [data-world="bench"] .section-body > .set-prose,
  [data-world="bench"] .section-body > .block-list {
    background: var(--window-bg);
    color: var(--window-ink);
    padding: 1.1rem 1.35rem;
    border-radius: 0;
  }
  [data-world="bench"] .hero-prose a,
  [data-world="bench"] .section-body > .set-prose a { color: #a33c00; }
  [data-world="bench"] .hero-prose strong,
  [data-world="bench"] .section-body > .set-prose strong { color: var(--window-ink); }
  [data-world="bench"] .memo-masthead, [data-world="bench"] .block-card,
  [data-world="bench"] .block-callout, [data-world="bench"] .block-stats,
  [data-world="bench"] .figure-guide, [data-world="bench"] .decision-card,
  [data-world="bench"] .block-table, [data-world="bench"] .context-diagram,
  [data-world="bench"] .map-entry {
    --ink: #17130d;
    --ink-2: #4a4438;
    --ink-3: #77705f;
    --accent: #a33c00;
    --accent-strong: #7c2e00;
    --rule: #d8cfb6;
    --hairline: #c8bd9f;
    border-radius: 0;
