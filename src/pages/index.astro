<script>
  // Desktop TOC Rail Interaction Elements
  const tocSidebar = document.getElementById('toc-sidebar');
  const tocCard = document.getElementById('toc-card');
  const tocExpandedView = document.getElementById('toc-expanded-view');
  const tocCollapsedView = document.getElementById('toc-collapsed-view');
  const collapseBtn = document.getElementById('collapse-toc-desktop');
  const expandBtn = document.getElementById('expand-toc-desktop');
  const floatingTooltip = document.getElementById('toc-floating-tooltip');
  const tocDots = document.querySelectorAll('.toc-dot');

  function collapseTOC() {
    if (!tocSidebar || !tocCard || !tocExpandedView || !tocCollapsedView) return;
    tocSidebar.classList.remove('w-72');
    tocSidebar.classList.add('w-14');
    tocCard.classList.remove('p-4');
    tocCard.classList.add('p-2', 'flex', 'flex-col', 'items-center');
    tocExpandedView.classList.add('hidden');
    tocCollapsedView.classList.remove('hidden');
    tocCollapsedView.classList.add('flex');
    localStorage.setItem('toc-collapsed', 'true');
  }

  function expandTOC() {
    if (!tocSidebar || !tocCard || !tocExpandedView || !tocCollapsedView) return;
    tocSidebar.classList.remove('w-14');
    tocSidebar.classList.add('w-72');
    tocCard.classList.remove('p-2', 'flex', 'flex-col', 'items-center');
    tocCard.classList.add('p-4');
    tocCollapsedView.classList.add('hidden');
    tocCollapsedView.classList.remove('flex');
    tocExpandedView.classList.remove('hidden');
    localStorage.setItem('toc-collapsed', 'false');
    floatingTooltip?.classList.add('hidden');
  }

  collapseBtn?.addEventListener('click', collapseTOC);
  expandBtn?.addEventListener('click', expandTOC);

  // Default is collapsed; only expand if user previously explicitly expanded it ('false')
  if (localStorage.getItem('toc-collapsed') === 'false') {
    expandTOC();
  }

  // Floating Tooltip for Collapsed Rail Dots
  tocDots.forEach((dot) => {
    dot.addEventListener('mouseenter', () => {
      if (!floatingTooltip) return;
      const text = dot.getAttribute('data-tooltip') || '';
      floatingTooltip.textContent = text;
      floatingTooltip.classList.remove('hidden');
      const rect = dot.getBoundingClientRect();
      const top = rect.top + (rect.height / 2);
      const left = rect.right + 12;
      floatingTooltip.style.top = `${top}px`;
      floatingTooltip.style.left = `${left}px`;
    });

    dot.addEventListener('mouseleave', () => {
      floatingTooltip?.classList.add('hidden');
    });
  });

  window.addEventListener('scroll', () => {
    floatingTooltip?.classList.add('hidden');
  }, { passive: true });

  // Mobile Drawer elements
  const toggleMobileBtn = document.getElementById('toggle-toc-mobile');
  const mobileDrawer = document.getElementById('mobile-drawer');
  const closeDrawerBtn = document.getElementById('close-drawer');
  const mobileLinks = document.querySelectorAll('.mobile-toc-link');

  // Mobile Drawer Toggle
  toggleMobileBtn?.addEventListener('click', () => {
    mobileDrawer?.classList.remove('hidden');
  });

  closeDrawerBtn?.addEventListener('click', () => {
    mobileDrawer?.classList.add('hidden');
  });

  mobileDrawer?.addEventListener('click', (e) => {
    if (e.target === mobileDrawer) {
      mobileDrawer.classList.add('hidden');
    }
  });

  mobileLinks.forEach((link) => {
    link.addEventListener('click', () => {
      mobileDrawer?.classList.add('hidden');
    });
  });

  // Scrollspy: Synchronously highlight active TOC link (Expanded) and dot indicator (Collapsed Rail)
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const id = entry.target.getAttribute('id');
        
        // Update Expanded Text Links
        document.querySelectorAll('.toc-link').forEach((link) => {
          if (link.getAttribute('href') === `#${id}`) {
            link.classList.add('text-emerald-800', 'dark:text-emerald-300', 'bg-emerald-50', 'dark:bg-emerald-950/60', 'font-bold', 'border-l-2', 'border-emerald-600');
            link.classList.remove('text-slate-600', 'dark:text-slate-400');
          } else {
            link.classList.remove('text-emerald-800', 'dark:text-emerald-300', 'bg-emerald-50', 'dark:bg-emerald-950/60', 'font-bold', 'border-l-2', 'border-emerald-600');
            link.classList.add('text-slate-600', 'dark:text-slate-400');
          }
        });

        // Update Collapsed Rail Dot Indicators
        document.querySelectorAll('.toc-dot').forEach((dotLink) => {
          const target = dotLink.getAttribute('data-target');
          const indicator = dotLink.querySelector('.dot-indicator');
          if (!indicator) return;

          if (target === id) {
            indicator.classList.add('bg-emerald-600', 'dark:bg-emerald-400', 'ring-4', 'ring-emerald-200', 'dark:ring-emerald-950', 'scale-125');
            indicator.classList.remove('bg-slate-300', 'dark:bg-slate-700');
          } else {
            indicator.classList.remove('bg-emerald-600', 'dark:bg-emerald-400', 'ring-4', 'ring-emerald-200', 'dark:ring-emerald-950', 'scale-125');
            indicator.classList.add('bg-slate-300', 'dark:bg-slate-700');
          }
        });
      }
    });
  }, { rootMargin: '-100px 0px -66% 0px' });

  document.querySelectorAll('section[id]').forEach((section) => {
    observer.observe(section);
  });

  // Floating Tooltip for Architectural Style Matrix with Hover Bridge
  const matrixTooltip = document.getElementById('matrix-tooltip');
  const matrixTooltipIcon = document.getElementById('matrix-tooltip-icon');
  const matrixTooltipTitle = document.getElementById('matrix-tooltip-title');
  const matrixTooltipDesc = document.getElementById('matrix-tooltip-desc');
  const matrixTooltipHint = document.getElementById('matrix-tooltip-hint');

  // Matrix Deep Dive Modal Elements
  const matrixCellModal = document.getElementById('matrix-cell-modal');
  const matrixModalCard = document.getElementById('matrix-modal-card');
  const matrixModalClose = document.getElementById('matrix-modal-close');
  const matrixModalFooterClose = document.getElementById('matrix-modal-footer-close');
  const matrixModalFeatureIcon = document.getElementById('matrix-modal-feature-icon');
  const matrixModalFeatureName = document.getElementById('matrix-modal-feature-name');
  const matrixModalStyleIcon = document.getElementById('matrix-modal-style-icon');
  const matrixModalStyleName = document.getElementById('matrix-modal-style-name');
  const matrixModalRatingBadge = document.getElementById('matrix-modal-rating-badge');
  const matrixModalHeadline = document.getElementById('matrix-modal-headline');
  const matrixModalCoreProblem = document.getElementById('matrix-modal-core-problem');
  const matrixModalTermsList = document.getElementById('matrix-modal-terms-list');
  const matrixModalTermsContainer = document.getElementById('matrix-modal-terms-container');
  const matrixModalFarmacyExample = document.getElementById('matrix-modal-farmacy-example');
  const matrixModalArchitecturalLesson = document.getElementById('matrix-modal-architectural-lesson');

  let deepDivesMap: Record<string, any> = {};
  const dataScript = document.getElementById('matrix-deep-dives-data');
  if (dataScript && dataScript.textContent) {
    try {
      deepDivesMap = JSON.parse(dataScript.textContent);
    } catch (err) {
      console.error('Error parsing matrix deep dives data:', err);
    }
  }

  function openMatrixCellModal(cellKey: string) {
    const detail = deepDivesMap[cellKey];
    if (!detail || !matrixCellModal || !matrixModalCard) return;

    // Dismiss tooltip
    hideMatrixTooltip();

    // Populate data
    if (matrixModalFeatureIcon) matrixModalFeatureIcon.textContent = detail.featureIcon;
    if (matrixModalFeatureName) matrixModalFeatureName.textContent = detail.featureName;
    if (matrixModalStyleIcon) matrixModalStyleIcon.textContent = detail.styleIcon;
    if (matrixModalStyleName) matrixModalStyleName.textContent = detail.styleName;
    
    if (matrixModalRatingBadge) {
      matrixModalRatingBadge.textContent = detail.ratingLabel;
      matrixModalRatingBadge.className = `px-2 py-0.5 rounded text-[11px] font-bold font-mono border ${detail.badgeClasses}`;
    }

    if (matrixModalHeadline) matrixModalHeadline.textContent = detail.headline;
    if (matrixModalCoreProblem) matrixModalCoreProblem.textContent = detail.coreProblem;

    if (matrixModalTermsList) {
      matrixModalTermsList.innerHTML = '';
      if (detail.keyTerms && detail.keyTerms.length > 0) {
        detail.keyTerms.forEach((item: { term: string; explanation: string }) => {
          const card = document.createElement('div');
          card.className = 'p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-800 space-y-1';
          
          const title = document.createElement('div');
          title.className = 'text-xs font-mono font-bold text-emerald-800 dark:text-emerald-300 flex items-center gap-1.5';
          title.innerHTML = `<span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0"></span><span>${item.term}</span>`;
          
          const exp = document.createElement('div');
          exp.className = 'text-xs text-slate-700 dark:text-slate-300 leading-relaxed pl-3';
          exp.textContent = item.explanation;
          
          card.appendChild(title);
          card.appendChild(exp);
          matrixModalTermsList.appendChild(card);
        });
        matrixModalTermsContainer?.classList.remove('hidden');
      } else {
        matrixModalTermsContainer?.classList.add('hidden');
      }
    }

    if (matrixModalFarmacyExample) matrixModalFarmacyExample.textContent = detail.farmacyExample;
    if (matrixModalArchitecturalLesson) matrixModalArchitecturalLesson.textContent = detail.architecturalLesson;

    // Show modal with animation
    matrixCellModal.classList.remove('hidden');
    requestAnimationFrame(() => {
      matrixCellModal.classList.remove('opacity-0');
      matrixModalCard.classList.remove('scale-95');
      matrixModalCard.classList.add('scale-100');
    });
    document.body.classList.add('overflow-hidden');
  }

  function closeMatrixCellModal() {
    if (!matrixCellModal || !matrixModalCard || matrixCellModal.classList.contains('hidden')) return;

    matrixCellModal.classList.add('opacity-0');
    matrixModalCard.classList.remove('scale-100');
    matrixModalCard.classList.add('scale-95');

    setTimeout(() => {
      matrixCellModal.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
    }, 200);
  }

  function hideMatrixTooltip() {
    matrixTooltip?.classList.add('hidden');
  }

  function showMatrixTooltip(el: Element) {
    if (!matrixTooltip || !matrixTooltipTitle || !matrixTooltipDesc) return;
    
    const title = el.getAttribute('data-tooltip-title') || '';
    const desc = el.getAttribute('data-tooltip-desc') || '';
    const icon = el.getAttribute('data-tooltip-icon') || 'ℹ️';
    const isCell = el.hasAttribute('data-cell-key');

    if (matrixTooltipIcon) matrixTooltipIcon.textContent = icon;
    matrixTooltipTitle.textContent = title;
    matrixTooltipDesc.textContent = desc;

    if (isCell) {
      matrixTooltipHint?.classList.remove('hidden');
    } else {
      matrixTooltipHint?.classList.add('hidden');
    }

    matrixTooltip.classList.remove('hidden');

    const rect = el.getBoundingClientRect();
    const tooltipRect = matrixTooltip.getBoundingClientRect();
    const margin = 6;

    // Prefer positioning below target; flip above if near bottom edge
    let top = rect.bottom + margin;
    if (top + tooltipRect.height > window.innerHeight - margin) {
      top = rect.top - tooltipRect.height - margin;
    }
    if (top < margin) top = margin;

    // Center horizontally on target, clamped within screen
    let left = rect.left + (rect.width / 2) - (tooltipRect.width / 2);
    if (left < margin) left = margin;
    if (left + tooltipRect.width > window.innerWidth - margin) {
      left = window.innerWidth - tooltipRect.width - margin;
    }

    matrixTooltip.style.top = `${top}px`;
    matrixTooltip.style.left = `${left}px`;
  }

  // Triggers (cells and headers)
  document.querySelectorAll('[data-matrix-tooltip]').forEach((el) => {
    el.addEventListener('mouseenter', () => showMatrixTooltip(el));
    el.addEventListener('mouseleave', hideMatrixTooltip);
    el.addEventListener('click', (e) => {
      e.stopPropagation();
      const cellKey = el.getAttribute('data-cell-key');
      if (cellKey) {
        hideMatrixTooltip();
        openMatrixCellModal(cellKey);
      } else {
        showMatrixTooltip(el);
      }
    });
  });

  // Modal close handlers
  matrixModalClose?.addEventListener('click', closeMatrixCellModal);
  matrixModalFooterClose?.addEventListener('click', closeMatrixCellModal);
  matrixCellModal?.addEventListener('click', (e) => {
    if (e.target === matrixCellModal) {
      closeMatrixCellModal();
    }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeMatrixCellModal();
    }
  });

  // Click outside to dismiss tooltip
  document.addEventListener('click', (e) => {
    const isTrigger = (e.target as HTMLElement | null)?.closest('[data-matrix-tooltip]');
    if (!isTrigger) {
      hideMatrixTooltip();
    }
  });

  // Dismiss immediately on page scroll
  window.addEventListener('scroll', hideMatrixTooltip, { passive: true });
</script>
