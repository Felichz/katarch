---
import Layout from '../layouts/Layout.astro';
import PodiumCounterpoint from '../components/PodiumCounterpoint.astro';
import RunnerUpInsight from '../components/RunnerUpInsight.astro';
import TheoryBox from '../components/TheoryBox.astro';
import Mermaid from '../components/Mermaid.astro';
import ArchColiderAdrs from '../components/ArchColiderAdrs.astro';
import ConceptChip from '../components/ConceptChip.astro';
import ConceptModal from '../components/ConceptModal.astro';
import { matrixDeepDives } from '../data/matrix-deep-dives';

const contextDiagram = `flowchart TD
    subgraph Canales["CANALES DE ENTRADA (Físicos & Digitales)"]
        direction LR
        Fridge["Smart Fridge<br/>(Byte Tech / RFID)"]
        Kiosk["Kiosco Asistido<br/>(Toast POS)"]
        WebMobile["Web & Mobile App<br/>(Pedidos & Membresías)"]
    end

    subgraph Core["PLATAFORMA FARMACY FOOD"]
        direction LR
        Inventario["Inventario Vivo"]
        Ordenes["Gestor de Órdenes"]
        Catalogo["Catálogo & Menú"]
    end

    subgraph Externos["SISTEMAS EXTERNOS & TERCEROS"]
        direction LR
        Kitchen["Ghost Kitchen<br/>(ChefTec)"]
        PaymentGW["Pasarela de Pagos<br/>(Stripe)"]
        Accounting["Contabilidad<br/>(QuickBooks)"]
    end

    Fridge -->|Stock RFID| Inventario
    Kiosk -->|Ventas Mostrador| Ordenes
    WebMobile -->|Pedidos Online| Ordenes

    Ordenes -->|Comandas Cocina| Kitchen
    Ordenes -->|Liquidación Cobros| PaymentGW
    Ordenes -->|Asientos Contables| Accounting`;

const styleDecisionTree = `flowchart TD
    Start["¿Qué estilo base elegir para Farmacy Food?"] --> Q1(["¿Operar sistemas distribuidos desde el Día 1?"])
    
    Q1 -->|NO: Priorizar simplicidad y bajo costo| SimpleRoot["ENFOQUES UNIFICADOS & SERVERLESS"]
    Q1 -->|SÍ: Priorizar desacople por servicio| DistRoot["ENFOQUES DISTRIBUIDOS & EVOLUTIVOS"]
    
    subgraph Simple["Simplicidad Operativa"]
        direction TB
        ArchColider["🥇 ArchColider (1° Puesto)<br/>Monolito Modular en AWS EC2<br/>• Mínimo costo operacional y 1 solo quantum<br/>• Extrae módulos solo bajo tensión real"]
        Pacman["⚡ Team-Pacman (Runner-Up)<br/>100% Serverless (Lambda + DynamoDB)<br/>• Costo $0 en reposo (ahorro del 70-90%)<br/>• Paga solo por ejecución; cold starts"]
    end

    subgraph Dist["Escala Distribuida"]
        direction TB
        MyagisForest["🥈 Myagis-Forest (2° Puesto)<br/>Microservicios + Hexagonal en K8s<br/>• Despliegue autónomo desde el Día 1<br/>• Sobrecosto operacional en K8s"]
        HeyDragon["⚡ Hey-Dragon (Runner-Up)<br/>Arquitectura Evolutiva en 3 Fases<br/>• Fase 1: Monolito rápido por capas<br/>• Fase 2: Servicios con DB compartida<br/>• Fase 3: Microservicios con eventos"]
    end

    SimpleRoot --> ArchColider
    SimpleRoot -.->|Alternativa Serverless| Pacman
    DistRoot --> MyagisForest
    DistRoot -.->|Alternativa Progresiva| HeyDragon`;

const posSequence = `sequenceDiagram
    autonumber
    participant Cliente as Cliente (Kiosco)
    participant POS as Toast POS
    participant Order as Order Svc (ArchColider)
    participant Inv as Inventory Subsystem
    participant Bus as RabbitMQ (EventBus)
    participant Survey as Feedback / Loyalty

    Cliente->>POS: Compra comida físicamente en local
    POS->>Order: POST /orders/transactions
    activate Order
    Order->>Inv: Decrementar Stock de Locación
    alt Stock disponible
        Inv-->>Order: Reserva Confirmada
        Order->>Order: EventStore: OrderCreated
        Order->>Bus: Publish: OrderCompletedEvent
        Order-->>POS: Ticket de Venta Aprobado
    else Sin stock
        Inv-->>Order: Error de Inventario
        Order-->>POS: Transacción Rechazada
    end
    deactivate Order

    Bus->>Survey: Consumir OrderCompletedEvent
    activate Survey
    Note over Survey: Proceso asíncrono desacoplado
    Survey->>Cliente: Envío diferido de Encuesta SMS
    deactivate Survey`;

const fridgeParadox = `sequenceDiagram
    autonumber
    participant Usuario as Usuario (Comensal)
    participant Sensor as Lector Tarjeta / RFID
    participant ByteNet as Red Byte Technology
    participant Farmacy as API Farmacy Food

    Usuario->>Sensor: Desliza tarjeta bancaria para abrir puerta
    Sensor->>ByteNet: Pre-autorización bancaria + Destraba física
    Note over Usuario,Sensor: Gesto físico único: Extracción libre de viandas RFID
    Usuario->>Sensor: Cierra la puerta de la heladera
    Sensor->>ByteNet: Lectura final de items sustraídos
    ByteNet->>ByteNet: Liquidación y cobro automático en tarjeta
    ByteNet-->>Farmacy: Webhook: Venta confirmada + Items retirados
    Note over Farmacy: Paradoja Hananoyama: Cobro automático ciego sin ventana de subsidio previo`;

const styleDescriptions: Record<string, { name: string; icon: string; desc: string }> = {
  traditional: {
    name: "Monolito Tradicional",
    icon: "🏛️",
    desc: "Todo el código de la aplicación se empaqueta y ejecuta como un proceso único sobre un único runtime, compartiendo una misma base de datos relacional sin aislamiento estricto de dominios.",
  },
  microservices: {
    name: "Microservicios",
    icon: "🌐",
    desc: "Sistema distribuido donde cada dominio es un servicio autónomo con su propia base de datos y ciclo de vida independiente, comunicados a través de la red (HTTP REST, gRPC o mensajería asíncrona).",
  },
  microkernel: {
    name: "Microkernel (Plugins)",
    icon: "🧩",
    desc: "Arquitectura basada en un 'núcleo' central mínimo con la lógica y flujo esencial, que se extiende dinámicamente mediante plugins independientes para agregar reglas secundarias o adaptadores.",
  },
  modular: {
    name: "Monolito Modular (Elegido)",
    icon: "🥇",
    desc: "Un único artefacto desplegable en un proceso único, pero con límites de dominio (Bounded Contexts) estrictos y comunicación intermodular exclusiva a través de interfaces y fachadas públicas.",
  },
};

const featureDescriptions: Record<string, { icon: string; desc: string }> = {
  "Facilidad de Despliegue": {
    icon: "🚀",
    desc: "Mide el esfuerzo, tiempo y riesgo operacional para poner una nueva versión en producción (pipeline simple de un único artefacto vs. decenas de pipelines y servicios coordinados).",
  },
  "Disponibilidad": {
    icon: "🛡️",
    desc: "Capacidad del sistema de mantenerse activo ante fallas imprevistas. Si un módulo tiene un bug o satura memoria, ¿se cae todo el sistema o se aísla el fallo?",
  },
  "Autonomía de Equipos": {
    icon: "👥",
    desc: "Capacidad de múltiples equipos de ingeniería para trabajar, probar y desplegar funcionalidades en paralelo sin pisarse el código ni bloquearse las entregas.",
  },
  "Trazabilidad de Errores": {
    icon: "🔍",
    desc: "Facilidad para diagnosticar y reproducir incidentes siguiendo logs y excepciones (un único stack trace local de punta a punta vs. trazas distribuidas entre nodos de red).",
  },
  "Rendimiento (Latencia)": {
    icon: "⚡",
    desc: "Tiempo de respuesta de extremo a extremo. Las llamadas a métodos en memoria toman microsegundos (μs); las llamadas entre servicios cruzan la red sumando milisegundos (ms) y serialización.",
  },
  "Modificabilidad": {
    icon: "🛠️",
    desc: "Facilidad para refactorizar o extender reglas de negocio sin provocar efectos colaterales indeseados ni romper módulos no relacionados.",
  },
  "Integridad Transaccional": {
    icon: "🔒",
    desc: "Garantía de consistencia ACID en operaciones de múltiples pasos (ej: descontar stock y cobrar). En una sola DB es nativa; entre servicios exige coordinar Sagas o 2PC con consistencia eventual.",
  },
  "Escalabilidad": {
    icon: "📈",
    desc: "Capacidad de incrementar capacidad de cómputo ante picos de demanda. ¿Se puede escalar solo el componente bajo carga (quirúrgico) o hay que replicar la aplicación entera (tosco)?",
  },
};

const styleMatrix = [
  {
    id: "despliegue",
    feature: "Facilidad de Despliegue",
    traditional: {
      rating: "++",
      reason: "Se compila en un único binario o contenedor (.jar, binario Go, imagen Docker) y se despliega en un solo paso de pipeline sin dependencias externas complejas.",
    },
    microservices: {
      rating: "-",
      reason: "Exige coordinar decenas de pipelines de CI/CD, versionar contratos de APIs, orquestar contenedores (Kubernetes) y gestionar dependencias cruzadas en cada release.",
    },
    microkernel: {
      rating: "-",
      reason: "Cada plugin puede tener versiones y dependencias distintas; validar la compatibilidad de contratos del core en tiempo de despliegue añade fricción continua.",
    },
    modular: {
      rating: "++",
      reason: "Aprovecha la gran ventaja operativa del monolito: todo el código estructurado en módulos se empaqueta y despliega como un único artefacto atómico.",
    },
  },
  {
    id: "disponibilidad",
    feature: "Disponibilidad",
    traditional: {
      rating: "-",
      reason: "Punto único de fallo: una fuga de memoria (OOM), un bucle infinito o un panic no capturado en cualquier funcionalidad derriba el proceso completo.",
    },
    microservices: {
      rating: "++",
      reason: "Aislamiento de fallas (bulkheading): si el microservicio de encuestas o recomendaciones colapsa, los servicios de cobro y apertura de heladeras siguen funcionando.",
    },
    microkernel: {
      rating: "+",
      reason: "El núcleo central se mantiene pequeño y estable. Si un plugin secundario falla, el core suele poder aislarlo o reiniciarlo sin derribar todo el sistema.",
    },
    modular: {
      rating: "-",
      reason: "Comparte el mismo runtime: aunque los dominios estén lógicamente aislados, comparten CPU y memoria. Si un módulo desborda la memoria, crashea el proceso entero.",
    },
  },
  {
    id: "autonomia",
    feature: "Autonomía de Equipos",
    traditional: {
      rating: "--",
      reason: "Alto acoplamiento humano: múltiples equipos trabajan en el mismo repo y tablas compartidas, generando bloqueos en releases y conflictos constantes de merge.",
    },
    microservices: {
      rating: "++",
      reason: "Máxima autonomía organizacional: cada equipo es dueño de su repositorio, base de datos y ciclo de vida, desplegando a producción de forma 100% independiente.",
    },
    microkernel: {
      rating: "++",
      reason: "Equipos o terceros pueden construir plugins de forma completamente aislada respetando únicamente los contratos públicos definidos por el core.",
    },
    modular: {
      rating: "+",
      reason: "Las fronteras claras entre módulos permiten asignar propietarios por dominio de negocio, aunque la salida a producción final sigue estando unificada.",
    },
  },
  {
    id: "trazabilidad",
    feature: "Trazabilidad de Errores",
    traditional: {
      rating: "++",
      reason: "Depuración directa: un único debugger local conectado al proceso, logs cronológicos en un solo archivo y stack trace continuo desde el controller hasta el repositorio.",
    },
    microservices: {
      rating: "-",
      reason: "Depuración distribuida compleja: rastrear una petición requiere instrumentación con OpenTelemetry/Jaeger, correlation IDs compartidos y buscar en múltiples motores de logs.",
    },
    microkernel: {
      rating: "+",
      reason: "El núcleo puede envolver las llamadas a plugins con interceptores centralizados, facilitando registrar exactamente qué plugin causó la anomalía.",
    },
    modular: {
      rating: "O",
      reason: "Ocurre dentro del mismo proceso, pero el uso de eventos de dominio o fachadas internas añade niveles de indirección respecto al monolito plano.",
    },
  },
  {
    id: "rendimiento",
    feature: "Rendimiento (Latencia)",
    traditional: {
      rating: "++",
      reason: "Llamadas directas a funciones en memoria (en microsegundos) y acceso local a la base de datos sin saltos de red adicionales.",
    },
    microservices: {
      rating: "+",
      reason: "Cada interacción entre servicios cruza la red (HTTP/gRPC), sumando latencia de transporte (ms), serialización de payloads (JSON/Protobuf) y reintentos.",
    },
    microkernel: {
      rating: "+",
      reason: "Las invocaciones núcleo-plugin son en memoria, con una penalización ínfima por capas de reflexión, proxies o interfaces dinámicas.",
    },
    modular: {
      rating: "++",
      reason: "Toda la comunicación intermodular es invocación directa a métodos en memoria dentro del mismo proceso sin overhead de red ni serialización.",
    },
  },
  {
    id: "modificabilidad",
    feature: "Modificabilidad",
    traditional: {
      rating: "O",
      reason: "Riesgo de degradación paulatina: al no haber barreras arquitectónicas enforced, cualquier programador puede acceder a tablas o clases de otro módulo, creando acoplamiento invisible.",
    },
    microservices: {
      rating: "++",
      reason: "Máxima flexibilidad tecnológica: podés reescribir un servicio en otro lenguaje, cambiar su motor de persistencia o actualizar librerías sin afectar al resto.",
    },
    microkernel: {
      rating: "+",
      reason: "Alta extensibilidad: incorporar nuevos requerimientos o reglas de negocio se hace creando un nuevo plugin sin tocar el código fuente del núcleo.",
    },
    modular: {
      rating: "+",
      reason: "Los Bounded Contexts y las APIs públicas de cada módulo garantizan que los cambios internos no rompan el resto del sistema, siempre que se respeten los contratos.",
    },
  },
  {
    id: "integridad",
    feature: "Integridad Transaccional",
    traditional: {
      rating: "++",
      reason: "Transacciones ACID nativas: operaciones compuestas (ej: autorizar pago y reservar stock) se ejecutan con BEGIN TRANSACTION y COMMIT en una única base de datos.",
    },
    microservices: {
      rating: "--",
      reason: "Bases de datos independientes por servicio: no existe transacción ACID global sin incurrir en 2PC (lento y frágil). Exige orquestar Sagas con consistencia eventual y compensaciones complejas.",
    },
    microkernel: {
      rating: "O",
      reason: "Depende del diseño de almacenamiento: si los plugins persisten en la DB central se preserva ACID; si cada plugin tiene su propio storage, se pierde.",
    },
    modular: {
      rating: "+",
      reason: "Al compartir la misma infraestructura de persistencia relacional pero con particionado lógico por esquemas/tablas, es factible coordinar transacciones ACID de forma segura.",
    },
  },
  {
    id: "escalabilidad",
    feature: "Escalabilidad",
    traditional: {
      rating: "--",
      reason: "Escalado tosco y costoso: para aumentar la capacidad de una función intensiva se debe duplicar el monolito entero con toda su huella de memoria y pool de conexiones a la DB.",
    },
    microservices: {
      rating: "++",
      reason: "Escalado elástico y quirúrgico: si el catálogo de comidas recibe 50x más visitas al mediodía que el módulo de pagos, se escalan solo las instancias del catálogo.",
    },
    microkernel: {
      rating: "-",
      reason: "El núcleo y los plugins escalan como una unidad indivisible; un plugin pesado tensiona el runtime completo.",
    },
    modular: {
      rating: "+",
      reason: "Escala horizontalmente replicando el monolito completo tras un balanceador de carga. Para el volumen inicial (68 heladeras) es sumamente económico y sencillo de operar.",
    },
  },
];

const ratingBadges: Record<string, { label: string; symbol: string; classes: string }> = {
  "++": {
    symbol: "++",
    label: "Excelente",
    classes: "bg-emerald-100 text-emerald-800 dark:bg-emerald-950/70 dark:text-emerald-300 border-emerald-300/60 dark:border-emerald-700",
  },
  "+": {
    symbol: "+",
    label: "Favorable",
    classes: "bg-emerald-50 text-emerald-700 dark:bg-emerald-950/30 dark:text-emerald-400 border-emerald-200/50 dark:border-emerald-800/50",
  },
  "O": {
    symbol: "O",
    label: "Neutro",
    classes: "bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400 border-slate-200 dark:border-slate-700",
  },
  "-": {
    symbol: "-",
    label: "Desfavorable",
    classes: "bg-amber-50 text-amber-700 dark:bg-amber-950/40 dark:text-amber-400 border-amber-200/60 dark:border-amber-800/60",
  },
  "--": {
    symbol: "--",
    label: "Crítico",
    classes: "bg-red-100 text-red-700 dark:bg-red-950/60 dark:text-red-300 border-red-200 dark:border-red-800",
  },
};
---

<Layout 
  title="El Kata de Farmacy Food: Cómo Deciden los Mejores Arquitectos de Software"
  description="Análisis comparativo de las soluciones del primer O'Reilly Architecture Kata y su conexión con Fundamentals of Software Architecture."
>
  <!-- Hero Section -->
  <div class="mb-12 border-b border-slate-200 dark:border-slate-800 pb-10 pl-2 sm:pl-6 lg:pl-10 pr-2 sm:pr-6 lg:pr-8 transition-colors">
    <div class="flex flex-wrap items-center gap-2 mb-4">
      <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-emerald-100 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 font-mono">
        O'Reilly Architecture Kata · Fall 2020
      </span>
      <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 font-mono">
        10 Equipos Evaluados
      </span>
      <span class="text-xs text-slate-500 dark:text-slate-400 font-mono">
        Lectura: ~20 minutos
      </span>
    </div>

    <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 dark:text-slate-100 tracking-tight leading-tight mb-5 max-w-5xl xl:max-w-6xl">
      El Kata de Farmacy Food:
      <span class="block mt-1 sm:mt-2 pb-1 text-transparent bg-clip-text bg-gradient-to-b from-emerald-600 to-teal-800 dark:from-emerald-200 dark:to-emerald-400">
        Cómo se toman decisiones reales de arquitectura
      </span>
    </h1>

    <div class="space-y-4 max-w-5xl xl:max-w-6xl text-slate-700 dark:text-slate-300 text-base sm:text-lg leading-relaxed">
      <p>
        Los Software Architecture Katas son competencias de diseño organizadas por <a href="http://oreilly.com/" target="_blank" rel="noopener noreferrer" class="text-emerald-700 dark:text-emerald-400 font-semibold underline underline-offset-2 hover:text-emerald-800 dark:hover:text-emerald-300">O'Reilly</a> donde equipos de ingeniería reciben el enunciado y las restricciones reales de un negocio para proyectar su arquitectura completa desde cero. Todos los diagramas, compensaciones técnicas y registros de decisión arquitectónica (ADRs) de los participantes se conservan en repositorios abiertos dentro de <a href="https://github.com/TheKataLog" target="_blank" rel="noopener noreferrer" class="text-emerald-700 dark:text-emerald-400 font-semibold underline underline-offset-2 hover:text-emerald-800 dark:hover:text-emerald-300">TheKataLog</a>, conformando una base de consulta pública para la comunidad técnica.
      </p>
      <p>
        Este artículo analiza con fines pedagógicos la primera edición del certamen (<em>Fall 2020: Farmacy Food</em>), evaluada por un jurado compuesto por Mark Richards y Neal Ford (autores de <a href="https://a.co/d/0fYSx8YG" target="_blank" rel="noopener noreferrer" class="text-emerald-700 dark:text-emerald-400 font-semibold underline underline-offset-2 hover:text-emerald-800 dark:hover:text-emerald-300">Fundamentals of Software Architecture</a>) y la consultora Jacqui Read.
      </p>
      <p>
        Para estudiar cómo se resuelven dilemas en la práctica, tomamos como guía la propuesta ganadora de <a href="https://github.com/TheKataLog/ArchColider/tree/master" target="_blank" rel="noopener noreferrer" class="text-emerald-700 dark:text-emerald-400 font-semibold underline underline-offset-2 hover:text-emerald-800 dark:hover:text-emerald-300">ArchColider</a> (1° puesto) y el razonamiento detrás de sus 16 ADRs. En paralelo, contrastamos sus elecciones con las alternativas de <a href="https://github.com/TheKataLog/Myagis-Forest/tree/main" target="_blank" rel="noopener noreferrer" class="text-emerald-700 dark:text-emerald-400 font-semibold underline underline-offset-2 hover:text-emerald-800 dark:hover:text-emerald-300">Myagis-Forest</a> (2° puesto) y <a href="https://github.com/TheKataLog/Jedis/tree/main" target="_blank" rel="noopener noreferrer" class="text-emerald-700 dark:text-emerald-400 font-semibold underline underline-offset-2 hover:text-emerald-800 dark:hover:text-emerald-300">Jedis</a> (3° puesto), sumando además aportes concretos de otros participantes (la auditoría de hardware de Hananoyama, el esquema de costos serverless de Team-Pacman o la estrategia de migración evolutiva de Hey-Dragon).
      </p>
      <p class="p-4 rounded-xl bg-emerald-50/50 dark:bg-emerald-950/20 border border-emerald-200/60 dark:border-emerald-800/60 text-slate-800 dark:text-emerald-200 text-sm sm:text-base">
        <strong>Propósito de esta guía:</strong> Diseñada especialmente para desarrolladores senior que buscan dar el salto hacia la arquitectura de software. En lugar de dar por sentada la jerga o repetir recetas teóricas abstractas, desarmamos el porqué de cada decisión técnica con números reales, análisis de compensaciones y la complejidad operativa de producción explicada paso a paso.
      </p>
    </div>
  </div>

  <!-- Main Article Layout with Collapsible Rail Sidebar -->
  <div class="relative flex flex-col lg:flex-row gap-8 items-start w-full min-w-0">
    
    <!-- Mobile TOC Trigger Button -->
    <div class="w-full flex items-center justify-between lg:hidden border-b border-slate-200 dark:border-slate-800 pb-3 mb-4">
      <button 
        id="toggle-toc-mobile" 
        type="button" 
        class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-xs font-mono font-medium text-slate-700 dark:text-slate-300 shadow-2xs hover:bg-slate-50 dark:hover:bg-slate-800"
      >
        <span>📑 Ver Índice de Contenidos</span>
        <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
        </svg>
      </button>
      <span class="text-xs font-mono text-slate-500">11 Secciones</span>
    </div>

    <!-- Sticky Desktop TOC (Expanded or Collapsed Rail) -->
    <aside 
      id="toc-sidebar" 
      class="hidden lg:block w-14 shrink-0 sticky top-24 transition-all duration-300 z-30"
    >
      <div id="toc-card" class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-2 flex flex-col items-center shadow-xs transition-all duration-300 overflow-x-hidden">
        
        <!-- Expanded View -->
        <div id="toc-expanded-view" class="transition-opacity duration-200 hidden">
          <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-2.5 mb-3">
            <span class="text-xs font-mono font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
              <span>📑 Índice</span>
            </span>
            <button 
              id="collapse-toc-desktop" 
              type="button" 
              class="inline-flex items-center gap-1 text-[11px] font-mono text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white px-2 py-1 rounded-md hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer border border-transparent hover:border-slate-200 dark:hover:border-slate-700"
              title="Colapsar índice a barra compacta de puntos"
            >
