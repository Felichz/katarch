---
import Layout from '../layouts/Layout.astro';
import PodiumCounterpoint from '../components/PodiumCounterpoint.astro';
import RunnerUpInsight from '../components/RunnerUpInsight.astro';
import TheoryBox from '../components/TheoryBox.astro';
import Mermaid from '../components/Mermaid.astro';
import ArchColiderAdrs from '../components/ArchColiderAdrs.astro';
import ConceptChip from '../components/ConceptChip.astro';
import ConceptModal from '../components/ConceptModal.astro';
import { matrixDeepDivesEn } from '../data/matrix-deep-dives';

const contextDiagram = `flowchart TD
    subgraph Channels["ENTRY CHANNELS (Physical & Digital)"]
        direction LR
        Fridge["Smart Fridge<br/>(Byte Tech / RFID)"]
        Kiosk["Assisted Kiosk<br/>(Toast POS)"]
        WebMobile["Web & Mobile App<br/>(Orders & Subscriptions)"]
    end

    subgraph Core["FARMACY FOOD PLATFORM"]
        direction LR
        Inventory["Live Inventory"]
        Orders["Order Manager"]
        Catalog["Catalog & Menu"]
    end

    subgraph External["EXTERNAL & THIRD-PARTY SYSTEMS"]
        direction LR
        Kitchen["Ghost Kitchen<br/>(ChefTec)"]
        PaymentGW["Payment Gateway<br/>(Stripe)"]
        Accounting["Accounting<br/>(QuickBooks)"]
    end

    Fridge -->|RFID Stock Events| Inventory
    Kiosk -->|Counter Purchases| Orders
    WebMobile -->|Online Orders| Orders

    Orders -->|Kitchen Orders| Kitchen
    Orders -->|Payment Settlement| PaymentGW
    Orders -->|Journal Entries| Accounting`;

const styleDecisionTree = `flowchart TD
    Start["Which foundational style fits Farmacy Food?"] --> Q1(["Operate distributed systems from Day 1?"])
    
    Q1 -->|NO: Prioritize low operational cost and simplicity| SimpleRoot["UNIFIED & SERVERLESS APPROACHES"]
    Q1 -->|YES: Prioritize autonomous service lifecycles| DistRoot["DISTRIBUTED & EVOLUTIONARY APPROACHES"]
    
    subgraph Simple["Unified Scale"]
        direction TB
        ArchColider["🥇 ArchColider (1st Place)<br/>Modular Monolith on AWS EC2<br/>• Single deployable unit<br/>• Bounded contexts via internal facades<br/>• Actor model for fridge concurrency"]
        Pacman["⚡ Team-Pacman (Runner-Up)<br/>100% Serverless on AWS Lambda<br/>• Scale to zero during idle periods<br/>• Lambda cold starts and cloud lock-in"]
    end

    subgraph Dist["Distributed Scale"]
        direction TB
        MyagisForest["🥈 Myagis-Forest (2nd Place)<br/>Microservices + Hexagonal on K8s<br/>• Autonomous releases from Day 1<br/>• High Kubernetes operational overhead"]
        HeyDragon["⚡ Hey-Dragon (Runner-Up)<br/>3-Stage Evolutionary Architecture<br/>• Stage 1: Fast layered monolith<br/>• Stage 2: Services sharing database<br/>• Stage 3: Event-driven microservices"]
    end

    SimpleRoot --> ArchColider
    SimpleRoot -.->|Serverless Alternative| Pacman
    DistRoot --> MyagisForest
    DistRoot -.->|Progressive Alternative| HeyDragon`;

const posSequence = `sequenceDiagram
    autonumber
    participant Customer as Customer (Kiosk)
    participant POS as Toast POS
    participant Order as Order Svc (ArchColider)
    participant Inv as Inventory Subsystem
    participant Bus as RabbitMQ (EventBus)
    participant Survey as Feedback / Loyalty

    Customer->>POS: Purchases meal at retail counter
    POS->>Order: POST /orders/transactions
    activate Order
    Order->>Inv: Decrement Location Stock
    alt Stock Available
        Inv-->>Order: Reservation Confirmed
        Order->>Order: EventStore: OrderCreated
        Order->>Bus: Publish: OrderCompletedEvent
        Order-->>POS: Approved Sales Receipt
    else Out of Stock
        Inv-->>Order: Inventory Error
        Order-->>POS: Transaction Declined
    end
    deactivate Order

    Bus->>Survey: Consume OrderCompletedEvent
    activate Survey
    Note over Survey: Decoupled asynchronous worker
    Survey->>Customer: Deferred SMS Survey Dispatch
    deactivate Survey`;

const fridgeParadox = `sequenceDiagram
    autonumber
    participant Patron as Customer (Patron)
    participant Sensor as Card Reader / RFID
    participant ByteNet as Byte Technology Network
    participant Farmacy as Farmacy Food API

    Patron->>Sensor: Swipes payment card to unlock door
    Sensor->>ByteNet: Bank pre-authorization + physical unlock
    Note over Patron,Sensor: Single physical action: free removal of RFID trays
    Patron->>Sensor: Closes the smart fridge door
    Sensor->>ByteNet: Final scan of remaining inventory
    ByteNet->>ByteNet: Automatic settlement and card charge
    ByteNet-->>Farmacy: Webhook: Confirmed sale + items taken
    Note over Farmacy: Hananoyama Paradox: Blind automatic charge without prior subsidy window`;

const styleDescriptions: Record<string, { name: string; icon: string; desc: string }> = {
  traditional: {
    name: "Traditional Monolith",
    icon: "🏛️",
    desc: "All application code packages and runs as a single process on a single runtime, sharing a relational database without strict domain isolation.",
  },
  microservices: {
    name: "Microservices",
    icon: "🌐",
    desc: "Distributed system where each business domain is an autonomous service with its own database, communicating over the network (REST, gRPC, or messaging).",
  },
  microkernel: {
    name: "Microkernel (Plugins)",
    icon: "🧩",
    desc: "Architecture built around a minimal core engine containing core workflows, dynamically extended through independent plugins to add custom behaviors.",
  },
  modular: {
    name: "Modular Monolith (Winner)",
    icon: "🥇",
    desc: "A single deployable artifact executing in one process, but with strict domain boundaries (Bounded Contexts) and internal module communication strictly via public facades.",
  },
};

const featureDescriptions: Record<string, { icon: string; desc: string }> = {
  "Deployment Simplicity": {
    icon: "🚀",
    desc: "Measures operational overhead and risk to release updates to production (single artifact pipeline vs. dozens of coordinated service deployments).",
  },
  "High Availability & Fault Isolation": {
    icon: "🛡️",
    desc: "Ability of the system to maintain uptime during unexpected failures. If a module crashes, does the whole application go down or is the fault isolated?",
  },
  "Team Autonomy & Velocity": {
    icon: "👥",
    desc: "Capacity of multiple engineering teams to develop, test, and release features in parallel without stepping on code or blocking releases.",
  },
  "Debugging & Traceability": {
    icon: "🔍",
    desc: "Ease of diagnosing production incidents using logs and stack traces (single local call stack vs. distributed traces across network hops).",
  },
  "Performance & Latency": {
    icon: "⚡",
    desc: "End-to-end response times. In-memory method calls execute in sub-microseconds; remote network calls add milliseconds, serialization, and connection overhead.",
  },
  "Maintainability & Modifiability": {
    icon: "🛠️",
    desc: "Ease of refactoring business logic without triggering unintended regressions in unrelated system components.",
  },
  "Transactional Integrity & ACID": {
    icon: "🔒",
    desc: "Guarantees of ACID consistency across multi-step operations. Native in a single relational DB; requires Sagas and eventual consistency across services.",
  },
  "Scalability & Resource Utilization": {
    icon: "📈",
    desc: "Ability to handle traffic spikes. Can individual bottlenecks scale surgically, or must the entire application be duplicated?",
  },
};

const styleMatrix = [
  {
    id: "despliegue",
    feature: "Deployment Simplicity",
    traditional: {
      rating: "++",
      reason: "Compiles into a single binary or container (.jar, Go binary, Docker image) and deploys in a single pipeline step without external runtime dependencies.",
    },
    microservices: {
      rating: "-",
      reason: "Demands coordinating dozens of CI/CD pipelines, versioning API contracts, orchestrating container clusters (Kubernetes), and managing cross-dependencies per release.",
    },
    microkernel: {
      rating: "-",
      reason: "Each plugin may introduce differing library versions and lifecycles; validating runtime compatibility against the core adds continuous operational friction.",
    },
    modular: {
      rating: "++",
      reason: "Retains the core operational simplicity of the monolith: modularized code packages and deploys as a single atomic artifact.",
    },
  },
  {
    id: "disponibilidad",
    feature: "High Availability & Fault Isolation",
    traditional: {
      rating: "-",
      reason: "Single point of failure: an unhandled exception, memory leak (OOM), or blocking thread in any module crashes the entire process.",
    },
    microservices: {
      rating: "++",
      reason: "Fault isolation (bulkheading): if a non-critical service like feedback surveys collapses, core checkout and fridge unlock workflows remain fully operational.",
    },
    microkernel: {
      rating: "+",
      reason: "The core engine remains lean and stable. When a secondary plugin fails, the host can catch the error without crashing core processing.",
    },
    modular: {
      rating: "-",
      reason: "Shared process runtime: while domains are logically decoupled, they share CPU and memory. An unconstrained memory spike can crash the instance.",
    },
  },
  {
    id: "autonomia",
    feature: "Team Autonomy & Velocity",
    traditional: {
      rating: "--",
      reason: "High organizational coupling: multiple teams share the same codebase and database tables, leading to merge conflicts and synchronized release trains.",
    },
    microservices: {
      rating: "++",
      reason: "Maximum team independence: each team owns its repository, datastore, and release pipeline, deploying to production completely independently.",
    },
    microkernel: {
      rating: "++",
      reason: "Separate squads or third-party teams develop plugins in total isolation adhering strictly to public contracts exposed by the core platform.",
    },
    modular: {
      rating: "+",
      reason: "Clear module boundaries enable domain ownership within a monorepo, though the final production release remains unified.",
    },
  },
  {
    id: "trazabilidad",
    feature: "Debugging & Traceability",
    traditional: {
      rating: "++",
      reason: "Direct local debugging: a single debugger attached to the process, chronological logs in one place, and unbroken call stacks from controller to database.",
    },
    microservices: {
      rating: "-",
      reason: "Complex distributed debugging: reconstructing a transaction requires OpenTelemetry/Jaeger, correlation IDs, and querying across multiple log engines.",
    },
    microkernel: {
      rating: "+",
      reason: "The core intercepts plugin invocations through centralized lifecycle hooks, making it clear which plugin triggered an error.",
    },
    modular: {
      rating: "O",
      reason: "Executes inside one process, but extensive domain events and internal facades introduce indirection compared to a simple flat monolith.",
    },
  },
  {
    id: "rendimiento",
    feature: "Performance & Latency",
    traditional: {
      rating: "++",
      reason: "Direct in-memory method invocations (microseconds) and local database transactions without cross-service network roundtrips.",
    },
    microservices: {
      rating: "+",
      reason: "Inter-service communication crosses the network (HTTP/gRPC), accumulating latency (milliseconds), payload serialization overhead, and retries.",
    },
    microkernel: {
      rating: "+",
      reason: "Core-to-plugin calls occur in memory, with only negligible reflection or dynamic interface dispatch penalties.",
    },
    modular: {
      rating: "++",
      reason: "All inter-module communication is direct in-memory method execution within the host process, eliminating network serialization overhead.",
    },
  },
  {
    id: "modificabilidad",
    feature: "Maintainability & Modifiability",
    traditional: {
      rating: "O",
      reason: "Gradual architectural decay: without enforced boundaries, developers bypass layers and query foreign tables directly, creating hidden coupling.",
    },
    microservices: {
      rating: "++",
      reason: "Maximum technology flexibility: individual services can be rewritten in different languages, migrate datastores, or upgrade libraries independently.",
    },
    microkernel: {
      rating: "+",
      reason: "High extensibility: introducing new business rules or adapters is done by creating a new plugin without modifying core engine source code.",
    },
    modular: {
      rating: "+",
      reason: "Bounded contexts and public facade interfaces ensure internal module refactoring does not break other modules as long as contracts hold.",
    },
  },
  {
    id: "integridad",
    feature: "Transactional Integrity & ACID",
    traditional: {
      rating: "++",
      reason: "Native ACID transactions: multi-table operations (e.g., payment approval and inventory reservation) commit within a single database transaction.",
    },
    microservices: {
      rating: "--",
      reason: "Isolated databases eliminate global ACID transactions without 2PC. Requires orchestrating Sagas with eventual consistency and compensation logic.",
    },
    microkernel: {
      rating: "O",
      reason: "Depends on storage design: if plugins share the core database, ACID is preserved; if plugins manage separate stores, transactions become distributed.",
    },
    modular: {
      rating: "+",
      reason: "Sharing a relational database instance with logical table/schema partitioning allows coordinating reliable ACID transactions when strictly necessary.",
    },
  },
  {
    id: "escalabilidad",
    feature: "Scalability & Resource Utilization",
    traditional: {
      rating: "--",
      reason: "Coarse scaling: scaling an intensive subcomponent requires replicating the entire application footprint, memory, and database connection pools.",
    },
    microservices: {
      rating: "++",
      reason: "Granular elasticity: if the meal catalog experiences 50x peak traffic at noon, only catalog service instances scale while billing remains minimal.",
    },
    microkernel: {
      rating: "-",
      reason: "The core and loaded plugins scale as an indivisible unit; a single resource-heavy plugin strains the entire runtime.",
    },
    modular: {
      rating: "+",
      reason: "Scales horizontally by replicating the modular application behind a load balancer. Highly economical and simple for initial startup volumes.",
    },
  },
];

const ratingBadges: Record<string, { label: string; symbol: string; classes: string }> = {
  "++": {
    symbol: "++",
    label: "Excellent",
    classes: "bg-emerald-100 text-emerald-800 dark:bg-emerald-950/70 dark:text-emerald-300 border-emerald-300/60 dark:border-emerald-700",
  },
  "+": {
    symbol: "+",
    label: "Favorable",
    classes: "bg-emerald-50 text-emerald-700 dark:bg-emerald-950/30 dark:text-emerald-400 border-emerald-200/50 dark:border-emerald-800/50",
  },
  "O": {
    symbol: "O",
    label: "Neutral",
    classes: "bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400 border-slate-200 dark:border-slate-700",
  },
  "-": {
    symbol: "-",
    label: "Challenging",
    classes: "bg-amber-50 text-amber-700 dark:bg-amber-950/40 dark:text-amber-400 border-amber-200/60 dark:border-amber-800/60",
  },
  "--": {
    symbol: "--",
    label: "Critical",
    classes: "bg-red-100 text-red-700 dark:bg-red-950/60 dark:text-red-300 border-red-200 dark:border-red-800",
  },
};
---

<Layout 
  title="The Farmacy Food Kata: How Real Architectural Decisions Are Made"
  description="A comparative architectural analysis of the inaugural O'Reilly Architecture Kata solutions connected to Fundamentals of Software Architecture."
  lang="en"
>
  <!-- Hero Section -->
  <div class="mb-12 border-b border-slate-200 dark:border-slate-800 pb-10 pl-2 sm:pl-6 lg:pl-10 pr-2 sm:pr-6 lg:pr-8 transition-colors">
    <div class="flex flex-wrap items-center gap-2 mb-4">
      <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-emerald-100 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 font-mono">
        O'Reilly Architecture Kata · Fall 2020
      </span>
      <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 font-mono">
        10 Evaluated Teams
      </span>
      <span class="text-xs text-slate-500 dark:text-slate-400 font-mono">
        Reading Time: ~20 minutes
      </span>
    </div>

    <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 dark:text-slate-100 tracking-tight leading-tight mb-5 max-w-5xl xl:max-w-6xl">
      The Farmacy Food Kata:
      <span class="block mt-1 sm:mt-2 pb-1 text-transparent bg-clip-text bg-gradient-to-b from-emerald-600 to-teal-800 dark:from-emerald-200 dark:to-emerald-400">
        How Real Architectural Decisions Are Made
      </span>
    </h1>

    <div class="space-y-4 max-w-5xl xl:max-w-6xl text-slate-700 dark:text-slate-300 text-base sm:text-lg leading-relaxed">
      <p>
        The Software Architecture Katas are premier system design competitions organized by <a href="http://oreilly.com/" target="_blank" rel="noopener noreferrer" class="text-emerald-700 dark:text-emerald-400 font-semibold underline underline-offset-2 hover:text-emerald-800 dark:hover:text-emerald-300">O'Reilly</a>, where engineering teams receive the real-world problem statement and constraints of an actual business to project its end-to-end architecture from scratch. All system diagrams, technical trade-offs, and Architectural Decision Records (ADRs) submitted by participants are preserved in public open-source repositories within <a href="https://github.com/TheKataLog" target="_blank" rel="noopener noreferrer" class="text-emerald-700 dark:text-emerald-400 font-semibold underline underline-offset-2 hover:text-emerald-800 dark:hover:text-emerald-300">TheKataLog</a>, forming a valuable reference for the global technical community.
      </p>
      <p>
        This analysis breaks down the inaugural edition of the tournament (<em>Fall 2020: Farmacy Food</em>), judged by a panel comprising Mark Richards and Neal Ford (co-authors of <a href="https://a.co/d/0fYSx8YG" target="_blank" rel="noopener noreferrer" class="text-emerald-700 dark:text-emerald-400 font-semibold underline underline-offset-2 hover:text-emerald-800 dark:hover:text-emerald-300">Fundamentals of Software Architecture</a>) alongside software consultant Jacqui Read.
      </p>
      <p>
        To examine how real-world architectural dilemmas are resolved in practice, we take as our primary guide the winning submission by <a href="https://github.com/TheKataLog/ArchColider/tree/master" target="_blank" rel="noopener noreferrer" class="text-emerald-700 dark:text-emerald-400 font-semibold underline underline-offset-2 hover:text-emerald-800 dark:hover:text-emerald-300">ArchColider</a> (1st Place) and the reasoning behind its 16 ADRs. In parallel, we contrast their choices against the runners-up <a href="https://github.com/TheKataLog/Myagis-Forest/tree/main" target="_blank" rel="noopener noreferrer" class="text-emerald-700 dark:text-emerald-400 font-semibold underline underline-offset-2 hover:text-emerald-800 dark:hover:text-emerald-300">Myagis-Forest</a> (2nd Place) and <a href="https://github.com/TheKataLog/Jedis/tree/main" target="_blank" rel="noopener noreferrer" class="text-emerald-700 dark:text-emerald-400 font-semibold underline underline-offset-2 hover:text-emerald-800 dark:hover:text-emerald-300">Jedis</a> (3rd Place), alongside notable contributions from other competitors (such as the hardware audit by Hananoyama, the serverless cost modeling by Team-Pacman, and the evolutionary migration roadmap by Hey-Dragon).
      </p>
      <p class="p-4 rounded-xl bg-emerald-50/50 dark:bg-emerald-950/20 border border-emerald-200/60 dark:border-emerald-800/60 text-slate-800 dark:text-emerald-200 text-sm sm:text-base">
        <strong>Goal of this guide:</strong> Designed specifically for senior engineers transitioning into software architecture. Rather than reciting abstract theory or buzzwords, we unpack the reasons behind each technical choice using concrete figures, trade-off analyses, and production operational considerations explained step by step.
      </p>
    </div>
  </div>

  <!-- Main Article Layout with Collapsible Rail Sidebar -->
  <div class="relative flex flex-col lg:flex-row gap-8 items-start w-full min-w-0">
    
    <!-- Mobile TOC Trigger Button -->
    <div class="w-full flex items-center justify-between lg:hidden border-b border-slate-200 dark:border-slate-800 pb-3 mb-4">
      <button 
        id="toggle-toc-mobile" 
        type="button" 
        class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-xs font-mono font-medium text-slate-700 dark:text-slate-300 shadow-2xs hover:bg-slate-50 dark:hover:bg-slate-800"
      >
        <span>📑 Table of Contents</span>
        <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
        </svg>
      </button>
      <span class="text-xs font-mono text-slate-500">11 Sections</span>
    </div>

    <!-- Sticky Desktop TOC (Expanded or Collapsed Rail) -->
    <aside 
      id="toc-sidebar" 
      class="hidden lg:block w-14 shrink-0 sticky top-24 transition-all duration-300 z-30"
    >
      <div id="toc-card" class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-2 flex flex-col items-center shadow-xs transition-all duration-300 overflow-x-hidden">
        
        <!-- Expanded View -->
        <div id="toc-expanded-view" class="transition-opacity duration-200 hidden">
          <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-2.5 mb-3">
            <span class="text-xs font-mono font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
              <span>📑 Table of Contents</span>
            </span>
            <button 
              id="collapse-toc-desktop" 
              type="button" 
              class="inline-flex items-center gap-1 text-[11px] font-mono text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white px-2 py-1 rounded-md hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer border border-transparent hover:border-slate-200 dark:hover:border-slate-700"
              title="Collapse table of contents into compact dot rail"
            >
              <span>Collapse</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
              </svg>
            </button>
          </div>

          <nav class="space-y-1 text-xs font-mono" id="toc-nav">
            <a href="#problema" class="toc-link block px-2.5 py-1 rounded-md text-slate-600 dark:text-slate-400 hover:text-emerald-700 dark:hover:text-emerald-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">1. The Problem: Farmacy Food</a>
            <a href="#tablero" class="toc-link block px-2.5 py-1 rounded-md text-slate-600 dark:text-slate-400 hover:text-emerald-700 dark:hover:text-emerald-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">2. The Global Podium</a>
            <a href="#dilema-1" class="toc-link block px-2.5 py-1 rounded-md text-slate-600 dark:text-slate-400 hover:text-emerald-700 dark:hover:text-emerald-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">3. Starting Principles</a>
            <a href="#dilema-2" class="toc-link block px-2.5 py-1 rounded-md text-slate-600 dark:text-slate-400 hover:text-emerald-700 dark:hover:text-emerald-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">4. The Style Decision</a>
            <a href="#dilema-3" class="toc-link block px-2.5 py-1 rounded-md text-slate-600 dark:text-slate-400 hover:text-emerald-700 dark:hover:text-emerald-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">5. Domain Modeling & DDD</a>
            <a href="#dilema-4" class="toc-link block px-2.5 py-1 rounded-md text-slate-600 dark:text-slate-400 hover:text-emerald-700 dark:hover:text-emerald-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">6. Data & Consistency</a>
            <a href="#dilema-5" class="toc-link block px-2.5 py-1 rounded-md text-slate-600 dark:text-slate-400 hover:text-emerald-700 dark:hover:text-emerald-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">7. Physical Hardware Reality</a>
            <a href="#dilema-6" class="toc-link block px-2.5 py-1 rounded-md text-slate-600 dark:text-slate-400 hover:text-emerald-700 dark:hover:text-emerald-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">8. Risk Management & ADRs</a>
            <a href="#archcolider-blueprint" class="toc-link block px-2.5 py-1 rounded-md text-slate-600 dark:text-slate-400 hover:text-emerald-700 dark:hover:text-emerald-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">9. Blueprint & 16 ADRs (Top 1)</a>
            <a href="#guia-campo" class="toc-link block px-2.5 py-1 rounded-md text-slate-600 dark:text-slate-400 hover:text-emerald-700 dark:hover:text-emerald-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">10. Field Guide (Best Practices)</a>
            <a href="#sintesis" class="toc-link block px-2.5 py-1 rounded-md text-slate-600 dark:text-slate-400 hover:text-emerald-700 dark:hover:text-emerald-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">11. Synthesis & Repositories</a>
          </nav>
        </div>

        <!-- Collapsed Rail View (Compact Dots) -->
        <div id="toc-collapsed-view" class="flex flex-col items-center py-1">
          <button 
            id="expand-toc-desktop" 
            type="button" 
            class="p-1.5 rounded-lg text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer mb-3"
            title="Expand full table of contents"
