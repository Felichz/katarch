        <RunnerUpInsight 
          team="Jedis" 
          tag="Chronological Roadmap" 
          title="Domain Decomposition Aligned with Business Growth Phases"
          githubUrl="https://github.com/TheKataLog/Jedis/blob/main/Strategy.md#L7-L15"
          githubSnippet="L7-L15"
          lang="en"
