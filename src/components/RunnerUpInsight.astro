---
interface Props {
  team: string;
  tag: string;
  title: string;
  githubUrl?: string;
  githubSnippet?: string;
  lang?: 'es' | 'en';
}

const { team, tag, title, githubUrl, githubSnippet, lang = 'es' } = Astro.props;
const isEnglish = lang === 'en';
const viewCodeText = isEnglish ? "View code/ADR" : "Ver código/ADR";
---

<div class="my-6 rounded-xl border border-dashed border-slate-300 dark:border-slate-700/80 bg-slate-50/70 dark:bg-slate-900/50 p-4 sm:p-5 transition-all hover:border-slate-400 dark:hover:border-slate-600 shadow-xs">
  <div class="flex flex-wrap items-center justify-between gap-2 mb-2.5">
    <div class="flex items-center gap-2 flex-wrap">
      <span class="inline-flex items-center whitespace-nowrap px-2.5 py-0.5 rounded-md text-[11px] font-bold bg-slate-200/90 dark:bg-slate-800 text-slate-800 dark:text-slate-200 border border-slate-300 dark:border-slate-700 font-mono">
        ⚡ Runner-Up: {team}
      </span>
      <span class="text-[10px] font-mono font-medium px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800/80 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700 whitespace-nowrap">
        {tag}
      </span>
    </div>
    {githubUrl && (
      <a 
        href={githubUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="inline-flex items-center gap-1 text-xs font-mono font-medium text-emerald-700 dark:text-emerald-400 hover:text-emerald-800 dark:hover:text-emerald-300 underline"
      >
        <span>{viewCodeText}</span>
        {githubSnippet && <span class="text-slate-500 dark:text-slate-400 font-normal">({githubSnippet})</span>}
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
        </svg>
      </a>
    )}
  </div>
  <h5 class="text-sm font-bold text-slate-900 dark:text-slate-100 mb-1.5">{title}</h5>
  <div class="text-xs sm:text-sm leading-relaxed text-slate-700 dark:text-slate-300">
    <slot />
  </div>
</div>
