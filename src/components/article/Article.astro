---
/**
 * KatArch article renderer — one component, two languages.
 * Content comes entirely from src/data/article/{es,en}.ts; this file owns
 * layout, interaction affordances and modals. Editorials rules encoded here:
 * concepts and ADRs open contextual modals (never spoilers of later
 * sections), and every modal locks page scroll.
 */
import type { ArticleContent } from '../../data/article/types';
import { CONCEPTS } from '../../data/article/concepts';
import { DECISIONS } from '../../data/article/decision-map';
import { ORIGINAL_DOCS } from '../../data/article/original-docs';
import BlockRenderer from './BlockRenderer.astro';

interface Props {
  content: ArticleContent;
}

const { content } = Astro.props;
const lang = content.lang;
const isES = lang === 'es';

const ui = {
  close: isES ? 'Cerrar' : 'Close',
} as const;

const conceptEntries = Object.entries(CONCEPTS);
const usedConcepts = new Set<string>();
const htmlSources: string[] = [...content.heroParagraphs];
for (const section of content.sections) {
  for (const block of section.blocks) {
    if (block.type === 'p' || block.type === 'list') {
      const htmls =
        block.type === 'p' ? [block.html] : (block as { items: string[] }).items;
      htmlSources.push(...htmls);
    } else if (block.type === 'cards') {
      htmlSources.push(...block.cards.map((c) => c.html));
    } else if (block.type === 'callout') {
      htmlSources.push(block.html);
    } else if (block.type === 'table') {
      htmlSources.push(...block.rows.flat());
    }
  }
}
for (const h of htmlSources) {
  for (const m of h.matchAll(/data-concept="([^"]+)"/g)) usedConcepts.add(m[1]);
}
const modalConcepts = conceptEntries.filter(([id]) => usedConcepts.has(id));

// Original-doc modals: only for docs actually referenced via data-doc in prose
// or from the decision cards (their ADR chips open adr-XXX doc modals)
const usedDocIds = new Set<string>();
for (const h of htmlSources) {
  for (const m of h.matchAll(/data-doc="([^"]+)"/g)) usedDocIds.add(m[1]);
}
for (const d of DECISIONS) for (const ref of d.adrs) usedDocIds.add(`adr-${ref.id}`);
const usedDocs = ORIGINAL_DOCS.filter((d) => usedDocIds.has(d.id));
const uiDocKicker = isES ? 'Documento original · ArchColider' : 'Original document · ArchColider';
const uiDocOpen = isES ? 'Ver archivo original en el repo de ArchColider' : 'Open the original file in the ArchColider repo';
---

<!-- Concept modal shells (only those actually referenced in the article) -->
{modalConcepts.map(([id, c]) => (
  <dialog id={`concept-${id}`} class="modal-shell" aria-labelledby={`concept-${id}-title`}>
    <div class="modal-card">
      <button class="modal-close" data-close-modal type="button" aria-label={ui.close}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
      <h3 id={`concept-${id}-title`} class="modal-title">{c.title[lang]}</h3>
      <div class="modal-body set-prose" set:html={c.body[lang]} />
    </div>
  </dialog>
))}

<!-- Original-doc modal shells (only those actually referenced in the article) -->
{usedDocs.map((d) => (
  <dialog class="modal-shell" data-doc-dialog={d.id} aria-labelledby={`doc-${d.id}-title`}>
    <div class="modal-card modal-card--doc">
      <button class="modal-close" data-close-modal type="button" aria-label={ui.close}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
      <p class="figure-guide-kicker">{uiDocKicker}</p>
      <h3 class="modal-title" id={`doc-${d.id}-title`}>
        <span data-doc-title-es hidden={!isES}>{d.titleEs}</span>
        <span data-doc-title-en hidden={isES}>{d.titleEn}</span>
      </h3>
      <div class="doc-footer">
        {d.htmlEs && (
          <span class="doc-lang-note" data-doc-note hidden={!isES}>
            {isES
              ? 'Traducción del artículo; el original en inglés es el documento de referencia.'
              : 'Translation by this project; the English original is the reference document.'}
          </span>
        )}
        <div class="doc-footer-actions">
          {/* The toggle is a Spanish-reader affordance: the English edition
              always shows the original document, with no switch. */}
          {isES && d.htmlEs && (
            <button class="doc-lang-toggle" data-doc-lang-toggle type="button">
              Ver original en inglés
            </button>
          )}
          <a
            class="doc-original-link"
            href={`https://github.com/TheKataLog/ArchColider/blob/master/${encodeURI(d.file)}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            {uiDocOpen}
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"/></svg>
          </a>
        </div>
      </div>
      {d.htmlEs ? (
        <>
          <div class="doc-prose" data-doc-content-es hidden={!isES} set:html={d.htmlEs} />
          <div class="doc-prose" data-doc-content-en hidden={isES} set:html={d.html} />
        </>
      ) : (
        <div class="doc-prose" set:html={d.html} />
      )}
    </div>
  </dialog>
))}

<!-- Lens stage: full-screen plate so the lens can reach every corner -->
<div class="lens-stage" data-lens-stage hidden>
  <div class="lens-stage-plate" data-lens-plate>
    <img class="lens-stage-img" data-lens-img src="" alt="" draggable="false" />
    <div class="figure-lens" data-lens-lens hidden></div>
    <span class="figure-lens-hint" data-lens-pill hidden></span>
  </div>
  <div class="lens-stage-bar">
    <span class="lens-stage-help">
      {isES
        ? 'scroll = zoom · clic en cualquier lado = cerrar · Esc = cerrar'
        : 'scroll = zoom · click anywhere = close · Esc = close'}
    </span>
    <button class="lens-stage-close" data-lens-close type="button">
      {isES ? 'Cerrar' : 'Close'}
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
  </div>
</div>

<div class="article-shell">
  <!-- Collapsible TOC rail: collapsed dots by default, expands to the full index -->
  <aside class="toc-rail" id="toc-rail" aria-label={content.tocTitle}>
    <div class="toc-card" data-toc-card>
      <button
        class="toc-expand"
        data-toc-expand
        type="button"
        aria-label={isES ? 'Expandir índice' : 'Expand contents'}
        title={isES ? 'Expandir índice' : 'Expand contents'}
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"/></svg>
      </button>
      <nav class="toc-full" data-toc-full hidden>
        <div class="toc-full-head">
          <p class="toc-heading">{content.tocTitle}</p>
          <button
            class="toc-collapse"
            data-toc-collapse
            type="button"
            aria-label={isES ? 'Colapsar índice' : 'Collapse contents'}
            title={isES ? 'Colapsar a barra de puntos' : 'Collapse to dot rail'}
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 19l-7-7 7-7"/></svg>
          </button>
        </div>
        {content.sections.map((s) => (
          <a href={`#${s.id}`} class="toc-item" data-toc={s.id}>
            <span class="toc-phase">{s.phase}</span>
            <span class="toc-title">{s.title}</span>
          </a>
        ))}
      </nav>
      <nav class="toc-dots" data-toc-dots>
        {content.sections.map((s) => (
          <a
            href={`#${s.id}`}
            class="toc-dot"
            data-toc={s.id}
            data-tooltip={s.title}
            aria-label={s.title}
          >
            <span class="dot-indicator" />
          </a>
        ))}
      </nav>
    </div>
    <div class="toc-tooltip" data-toc-tooltip hidden></div>
  </aside>

  <article class="article">
    <!-- Hero -->
    <header class="hero">
      <div class="memo-masthead">
        <p class="mast-row"><span class="mast-key">{isES ? 'Documento' : 'Document'}</span><span class="mast-val">KatArch · {isES ? 'reconstrucción de un caso real' : 'a real case, reconstructed'}</span></p>
        <p class="mast-row"><span class="mast-key">{isES ? 'Serie' : 'Series'}</span><span class="mast-val">KATA/2020-FALL · Farmacy Food · O&#8217;Reilly Software Architecture Kata</span></p>
        <p class="mast-row"><span class="mast-key">{isES ? 'Estado' : 'Status'}</span><span class="mast-val">{isES ? 'Aceptado · fuentes: repos públicos de los equipos' : 'Accepted · sources: the teams public repos'}</span></p>
      </div>
      <h1 class="hero-title">
        {content.heroTitleA}
        <span class="hero-title-b">{content.heroTitleB}</span>
      </h1>
      <div class="hero-prose set-prose">
        {content.heroParagraphs.map((p) => <p set:html={p} />)}
      </div>
    </header>

    {content.sections.map((section, si) => {
      const prevPhase = si > 0 ? content.sections[si - 1].phase : null;
      const phaseChanged = section.phase !== prevPhase;
      return (
        <section id={section.id} class="article-section" data-section>
          {phaseChanged && si > 0 && (
            <div class="phase-divider">
              <span>{section.phase}</span>
            </div>
          )}
          <h2 class="section-title">{section.title}</h2>
          <div class="section-body">
            {section.blocks.map((block) => (
              <BlockRenderer block={block} lang={lang} />
            ))}
          </div>
        </section>
      );
    })}

    <footer class="article-closing">
      <p class="closing-title">{content.closing.title}</p>
      {content.closing.paragraphs.map((p) => <p>{p}</p>)}
    </footer>
  </article>
</div>

<script>
  import '../../scripts/article-interactions';
</script>

<style is:global>
  /* Anchor jumps (decision map -> inline cards) glide instead of teleporting */
  html { scroll-behavior: smooth; }

  /* ══ THE MEMO WORLD ═══════════════════════════════════════
     Light: a specification on laid paper. Dark: the same memo
     under a desk lamp. Courier Prime carries the document
     apparatus; Source Serif 4 carries the reading; one reference
     blue; hairline rules; paragraphs numbered in the gutter like
     the lines of a memo. */

  /* ── Shell ─────────────────────────────────────────── */
  .article-shell {
    display: flex;
    gap: 3.5rem;
    align-items: flex-start;
    width: 100%;
    max-width: 82rem;
    margin: 0 auto;
    min-width: 0;
  }
  .article { flex: 1; min-width: 0; counter-reset: ksec kpara kfig; }

  /* ── TOC rail: the memo's index ────────────────────── */
  .toc-rail { position: sticky; top: 5rem; flex: 0 0 auto; z-index: 30; }
  .toc-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    border-radius: 2px;
    border: 1px solid var(--rule);
    background: var(--paper-raised);
    padding: 0.4rem;
    overflow: hidden;
    /* no width transition: layout animation freezes in embedded browsers */
    width: 3rem;
  }
  .toc-card[data-expanded] {
    width: 21rem;
    align-items: stretch;
    padding: 0.75rem;
    max-height: calc(100vh - 7rem);
    overflow-y: auto;
  }
  .toc-expand {
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 2px;
    color: var(--ink-3);
    cursor: pointer;
    background: none;
    border: 1px solid transparent;
  }
  .toc-expand:hover { color: var(--accent); border-color: var(--rule); }
  .toc-card[data-expanded] .toc-expand { display: none; }
  .toc-dots {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    padding-top: 0.35rem;
  }
  .toc-card[data-expanded] .toc-dots { display: none; }
  .toc-dot {
    position: relative;
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 2px;
  }
  .toc-dot:hover { background: var(--paper-deep); }
  .dot-indicator {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 1px;
    background: var(--ink-3);
    transition: background 0.2s, box-shadow 0.2s;
  }
  .toc-dot:hover .dot-indicator { background: var(--ink-2); }
  .toc-dot.active .dot-indicator {
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-wash);
  }
  .toc-full { display: flex; flex-direction: column; gap: 1px; }
  .toc-full[hidden] { display: none; }
  .toc-full-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding-bottom: 0.6rem;
    margin-bottom: 0.5rem;
    border-bottom: 1px solid var(--rule);
  }
  .toc-collapse {
    display: grid;
    place-items: center;
    width: 1.8rem;
    height: 1.8rem;
    border-radius: 2px;
    color: var(--ink-3);
    cursor: pointer;
    background: none;
    border: none;
  }
  .toc-collapse:hover { color: var(--ink); background: var(--paper-deep); }
  .toc-tooltip {
    position: fixed;
    z-index: 60;
    padding: 0.3rem 0.6rem;
    border-radius: 2px;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-app);
    font-size: 0.78rem;
    white-space: nowrap;
    pointer-events: none;
    transform: translateY(-50%);
    border: 1px solid var(--ink);
    max-width: 20rem;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .toc-heading {
    font-size: 0.72rem;
    font-family: var(--font-app);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--ink-2);
  }
  .toc-item {
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding: 0.45rem 0.6rem;
    border-radius: 2px;
    font-size: 0.95rem;
    line-height: 1.35;
    color: var(--ink-2);
    text-decoration: none;
    transition: color 0.15s, background-color 0.15s;
  }
  .toc-item:hover { color: var(--ink); background: var(--paper-deep); }
  .toc-item.active { color: var(--accent); background: var(--accent-wash); }
  .toc-phase {
    font-size: 0.68rem;
    font-family: var(--font-app);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink-2);
  }
  .toc-title { font-weight: 600; color: inherit; }
  @media (max-width: 71.99rem) {
    .toc-rail { display: none; }
  }

  /* ── Hero: the memo masthead ───────────────────────── */
  .hero { padding-bottom: 2.75rem; border-bottom: 1px solid var(--rule); margin-bottom: 2.75rem; }
  .memo-masthead {
    border: 1px solid var(--rule);
    border-radius: 2px;
    background: var(--paper-raised);
    padding: 0.85rem 1.1rem;
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .mast-row {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 0.9rem;
    align-items: baseline;
  }
  .mast-key {
    font-family: var(--font-app);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--ink-2);
  }
  .mast-val {
    font-family: var(--font-app);
    font-size: 0.82rem;
    color: var(--ink-2);
    line-height: 1.5;
  }
  .hero-title {
    font-size: clamp(2rem, 4.6vw, 3.25rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-bottom: 1.6rem;
    max-width: 44ch;
  }
  .hero-title-b { display: block; color: var(--accent); }
  .hero-prose { max-width: none; margin-bottom: 0.5rem; }
  .hero-prose p + p { margin-top: 1rem; }

  /* ── Sections: numbered like a memo's parts ────────── */
  .article-section { min-width: 0; scroll-margin-top: 5rem; }
  .article-section + .article-section { margin-top: 3.75rem; }
  .article .set-prose,
  .article .block-list {
    font-size: clamp(1.06rem, 0.64rem + 0.36vw, 1.26rem);
  }
  .phase-divider {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2.75rem;
  }
  .phase-divider::before,
  .phase-divider::after {
    content: '';
    height: 1px;
    background: var(--rule);
    flex: 1;
  }
  .phase-divider span {
    font-size: 0.72rem;
    font-family: var(--font-app);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--ink-2);
    white-space: nowrap;
  }
  .section-title {
    counter-increment: ksec;
    font-size: clamp(1.5rem, 3vw, 1.95rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: 1.4rem;
    color: var(--ink);
  }
  .section-title::before {
    content: '\00a7' counter(ksec) '\00a0\00a0';
    font-family: var(--font-app);
    font-weight: 700;
    font-size: 0.62em;
    color: var(--accent);
    letter-spacing: 0.06em;
    vertical-align: 0.28em;
  }
  .section-body { display: flex; flex-direction: column; gap: 1.2rem; }

  /* ── The traceability gutter: numbered paragraphs ──── */
  /* Desktop-only apparatus by decision: below 72rem the memo drops its
     gutter (the reading column is the priority); paragraph anchors for
     cross-references are recorded as future work in DESIGN.md. */
  @media (min-width: 72rem) {
    .article { padding-left: 3.4rem; }
    .article .set-prose > p {
      counter-increment: kpara;
      position: relative;
    }
    .article .set-prose > p::before {
      content: counter(kpara);
      position: absolute;
      left: -2.9rem;
      width: 2.2rem;
      text-align: right;
      font-family: var(--font-app);
      font-size: 0.68rem;
      line-height: 2.4;
      color: var(--ink-2);
    }
    .article .set-prose > p:hover::before { color: var(--accent); }
    /* The reading-guide panels are annotations, not memo body */
    .figure-guide .set-prose > p { counter-increment: none; }
    .figure-guide .set-prose > p::before { content: none; }
  }

  /* ── Blocks ────────────────────────────────────────── */
  .set-prose { line-height: 1.78; }
  .set-prose a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .set-prose a:hover { color: var(--accent-strong); }
  .set-prose strong { color: inherit; font-weight: 700; }
  .block-h3 {
    font-size: 1.16rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-top: 1.35rem;
    margin-bottom: -0.3rem;
    color: var(--ink);
  }
  .block-list { padding-left: 1.35rem; display: flex; flex-direction: column; gap: 0.55rem; line-height: 1.72; }
  .block-list li::marker { color: var(--accent); }

  /* Cards: attachment blocks */
  .block-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.9rem;
    margin: 0.5rem 0;
  }
  @media (min-width: 48rem) {
    .block-cards { grid-template-columns: repeat(3, 1fr); }
    .block-cards[data-cols='2'] { grid-template-columns: repeat(2, 1fr); }
  }
  .block-card {
    padding: 1.1rem 1.15rem;
    border-radius: 2px;
    border: 1px solid var(--rule);
    background: var(--paper-raised);
  }
  .block-card .tag {
    display: inline-block;
    font-size: 0.68rem;
    font-family: var(--font-app);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }
  .block-card h4 { font-size: 1.02rem; font-weight: 700; margin-bottom: 0.5rem; color: var(--ink); }
  .block-card p { font-size: 0.98rem; line-height: 1.68; color: var(--ink-2); }

  /* Stats: the memo's measurements row */
  .block-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    border: 1px solid var(--rule);
    border-radius: 2px;
    overflow: hidden;
    background: var(--rule);
  }
  @media (min-width: 48rem) { .block-stats { grid-template-columns: repeat(4, 1fr); } }
  .stat-cell { padding: 1.1rem 1.15rem; background: var(--paper-raised); }
  .stat-value {
    font-family: var(--font-app);
    font-size: 1.45rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--accent);
    line-height: 1.15;
  }
  .stat-label { font-size: 0.95rem; line-height: 1.45; color: var(--ink-2); margin-top: 0.4rem; }

  /* Callouts: errata and margin notes of the memo */
  .block-callout {
    padding: 1.15rem 1.35rem;
    border-radius: 2px;
    margin: 0.5rem 0;
    border: 1px solid var(--rule);
    background: var(--paper-raised);
  }
  /* Errata boxes are apparatus: their text fills the box, not the 46rem column */
  .block-callout .set-prose { max-width: none; }
  .block-callout h4 {
    font-family: var(--font-app);
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    margin-bottom: 0.55rem;
    color: var(--ink-2);
  }
  .block-callout p { font-size: 1rem; line-height: 1.72; }
  .block-callout[data-tone='reference'] { background: var(--accent-wash); border-color: var(--accent); }
  .block-callout[data-tone='reference'] h4 { color: var(--accent); }
  .block-callout[data-tone='amber'] { background: var(--amber-wash); border-color: var(--amber); }
  .block-callout[data-tone='amber'] h4 { color: var(--amber); }
  .block-callout[data-tone='note'] h4::before { content: '\2014\00a0'; }

  /* Tables: ruled register pages */
  .block-table table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.98rem;
  }
  .block-table { border: 1px solid var(--rule); border-radius: 2px; overflow: hidden; background: var(--paper-raised); }
  .block-table .tbl-caption {
    font-size: 0.72rem;
    font-family: var(--font-app);
    text-transform: uppercase;
