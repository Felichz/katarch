---
import type { DecisionEntry } from '../../data/article/decision-map';

interface Props {
  entry: DecisionEntry;
  lang: 'es' | 'en';
  variant?: 'inline' | 'map';
}

const { entry, lang, variant = 'inline' } = Astro.props;
const isES = lang === 'es';

const labels = {
  problem: isES ? 'El problema' : 'The problem',
  decision: isES ? 'La decisión' : 'The decision',
  tradeoff: isES ? 'La compensación' : 'The trade-off',
  lensHint: isES ? 'clic para activar la lupa' : 'click to enable the lens',
} as const;

// Embedded figures inside the decision prose get the inline lens treatment:
// the zoom wrapper is the figure itself, lens + hint injected after the img.
const withLens = (html: string) =>
  html.replace(
    /(<figure class="modal-figure">.*?<img[^>]*>)/s,
    `$1<div class="figure-lens" hidden></div><span class="figure-lens-hint" hidden>${labels.lensHint}</span>`,
  ).replace('<figure class="modal-figure">', '<figure class="modal-figure" data-figure-zoom>');

const decisionHtml = withLens(entry.decision[lang]);
---

{variant === 'inline' ? (
  <div class="decision-card" id={`decision-${entry.id}`} data-decision-card={entry.id}>
    <h4>{entry.title[lang]}</h4>
    <dl>
      <div>
        <dt>{labels.problem}</dt>
        <dd set:html={entry.problem[lang]} />
      </div>
      <div>
        <dt>{labels.decision}</dt>
        <dd set:html={decisionHtml} />
      </div>
      <div>
        <dt>{labels.tradeoff}</dt>
        <dd set:html={entry.tradeoff[lang]} />
      </div>
    </dl>
    <div class="decision-adrs">
      {entry.adrs.map((ref) => (
        <button class="doc-ref" data-doc={`adr-${ref.id}`} type="button">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
          {ref.label}
        </button>
      ))}
    </div>
  </div>
) : (
  <a class="map-entry" href={`#decision-${entry.id}`}>
    <span class="entry-title">{entry.title[lang]}</span>
    <span class="entry-adrs">{entry.adrs.map((a) => a.label.split('·')[0].trim()).join(' · ')}</span>
  </a>
)}
