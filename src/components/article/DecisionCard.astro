---
import type { DecisionEntry } from '../../data/article/decision-map';

interface Props {
  entry: DecisionEntry;
  lang: 'es' | 'en';
  variant?: 'inline' | 'map';
}

const { entry, lang, variant = 'inline' } = Astro.props;
const isES = lang === 'es';

// The decision field may carry rich HTML (e.g. an embedded figure) for the
// modal; the inline summary shows only the leading prose.
const oneLine = entry.decision[lang].split('<figure')[0].replace(/<[^>]*>/g, '').trim();

const labels = {
  open: isES ? 'Leer la decisión completa' : 'Read the full decision',
} as const;
---
{variant === 'inline' ? (
  <div class="decision-card decision-card--summary">
    <h4>{entry.title[lang]}</h4>
    <p class="decision-one-line">{oneLine}</p>
    <button class="decision-open" type="button" data-decision={entry.id}>
      {labels.open} →
    </button>
  </div>
) : (
  <button class="map-entry" type="button" data-decision={entry.id}>
    <span class="entry-title">{entry.title[lang]}</span>
    <span class="entry-adrs">{entry.adrs.map((a) => a.label.split('·')[0].trim()).join(' · ')}</span>
  </button>
)}
