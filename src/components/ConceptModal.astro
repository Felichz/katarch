---
import { conceptDeepDives, conceptDeepDivesEn } from '../data/concept-deep-dives';

interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const isEnglish = lang === 'en';
const concepts = isEnglish ? conceptDeepDivesEn : conceptDeepDives;
---

<!-- Concept Deep Dive Modal -->
<div 
  id="concept-modal" 
  class="hidden fixed inset-0 z-50 bg-slate-950/75 dark:bg-black/80 backdrop-blur-xs p-3 sm:p-5 flex items-center justify-center opacity-0 transition-opacity duration-200"
  role="dialog"
  aria-modal="true"
  aria-labelledby="concept-modal-title"
>
  <div 
    id="concept-modal-card"
    class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-2xl w-full max-w-2xl max-h-[90vh] flex flex-col overflow-hidden text-slate-900 dark:text-slate-100 transform transition-all duration-200 scale-95"
  >
    <!-- Modal Header -->
    <div class="px-5 py-4 sm:px-6 sm:py-4 border-b border-slate-200 dark:border-slate-800 bg-slate-50/80 dark:bg-slate-900/80 flex items-start justify-between gap-4">
      <div class="space-y-1.5">
        <div class="flex items-center gap-2 flex-wrap text-xs font-mono text-slate-500 dark:text-slate-400">
          <span id="concept-modal-category-icon" class="text-sm"></span>
          <span id="concept-modal-category" class="font-semibold text-emerald-800 dark:text-emerald-300"></span>
          <span class="opacity-40">·</span>
          <span class="px-2 py-0.5 rounded text-[10px] font-bold font-mono bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
            {isEnglish ? "Deep Dive" : "Concepto Clave"}
          </span>
        </div>
        <h3 id="concept-modal-title" class="text-lg sm:text-xl font-bold text-slate-900 dark:text-slate-100 leading-snug"></h3>
        <p id="concept-modal-headline" class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed font-sans"></p>
      </div>
      <button 
        id="concept-modal-close" 
        type="button" 
        class="shrink-0 p-1.5 rounded-lg text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors focus:outline-hidden cursor-pointer"
        aria-label={isEnglish ? "Close modal" : "Cerrar modal"}
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Modal Content (Scrollable) -->
    <div class="p-5 sm:p-6 overflow-y-auto space-y-5 text-sm leading-relaxed text-slate-700 dark:text-slate-300">
      
      <!-- Frontend Developer Analogy -->
      <div id="concept-modal-analogy-box" class="p-4 rounded-xl bg-blue-50/70 dark:bg-blue-950/25 border border-blue-200/80 dark:border-blue-800/60">
        <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-blue-800 dark:text-blue-300 mb-1.5 flex items-center gap-1.5">
          <span>💡</span>
          <span>{isEnglish ? "Frontend Developer Mental Model" : "Analogía para Desarrolladores Frontend"}</span>
        </h4>
        <p id="concept-modal-analogy" class="text-slate-800 dark:text-blue-100 text-xs sm:text-sm leading-relaxed"></p>
      </div>

      <!-- Problem Details / Mechanism in Depth -->
      <div>
        <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2 flex items-center gap-1.5">
          <span>⚙️</span>
          <span>{isEnglish ? "The Mechanism in Detail" : "El Mecanismo en Detalle"}</span>
        </h4>
        <p id="concept-modal-mechanism" class="leading-relaxed text-slate-800 dark:text-slate-200 text-xs sm:text-sm"></p>
      </div>

      <!-- Key Terms Glossary -->
      <div id="concept-modal-terms-container" class="space-y-2">
        <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2 flex items-center gap-1.5">
          <span>📚</span>
          <span>{isEnglish ? "Key Architecture Jargon" : "Glosario de Términos Técnicos"}</span>
        </h4>
        <div id="concept-modal-terms-list" class="space-y-2.5"></div>
      </div>

      <!-- Real-world Case in Farmacy Food -->
      <div id="concept-modal-farmacy-box" class="p-4 rounded-xl bg-emerald-50/70 dark:bg-emerald-950/25 border border-emerald-200/80 dark:border-emerald-800/60">
        <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-emerald-800 dark:text-emerald-300 mb-1.5 flex items-center gap-1.5">
          <span>🥗</span>
          <span>{isEnglish ? "In Practice: Farmacy Food Case" : "En la Práctica: Caso Farmacy Food"}</span>
        </h4>
        <p id="concept-modal-farmacy" class="text-slate-800 dark:text-emerald-100 text-xs sm:text-sm leading-relaxed"></p>
      </div>

      <!-- ArchColider Original Quote -->
      <div id="concept-modal-quote-box" class="p-4 rounded-xl bg-amber-50/60 dark:bg-amber-950/20 border-l-4 border-amber-500 text-slate-800 dark:text-amber-200">
        <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-amber-800 dark:text-amber-300 mb-1.5 flex items-center gap-1.5">
          <span>💬</span>
          <span>{isEnglish ? "ArchColider's Original Document" : "Las Palabras Originales de ArchColider"}</span>
        </h4>
        <p id="concept-modal-quote" class="text-xs sm:text-sm leading-relaxed font-mono italic text-slate-800 dark:text-amber-100"></p>
      </div>

      <!-- Architectural Lesson -->
      <div id="concept-modal-lesson-box" class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/50 border-l-4 border-emerald-500 text-slate-700 dark:text-slate-300">
        <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300 mb-1 flex items-center gap-1.5">
          <span>💡</span>
          <span>{isEnglish ? "Architectural Takeaway" : "Criterio para el Diseñador"}</span>
        </h4>
        <p id="concept-modal-lesson" class="text-xs sm:text-sm leading-relaxed italic text-slate-800 dark:text-slate-200"></p>
      </div>

    </div>

    <!-- Modal Footer -->
    <div class="px-5 py-3 sm:px-6 bg-slate-50/80 dark:bg-slate-900/80 border-t border-slate-200 dark:border-slate-800 flex items-center justify-between">
      <span class="text-[11px] font-mono text-slate-500 dark:text-slate-400">
        {isEnglish ? "Press " : "Presioná "}
        <kbd class="px-1.5 py-0.5 rounded bg-slate-200 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 text-[10px] font-mono">Esc</kbd>
        {isEnglish ? " to exit" : " para salir"}
      </span>
      <button 
        id="concept-modal-footer-close" 
        type="button" 
        class="px-4 py-1.5 rounded-lg text-xs font-mono font-medium bg-emerald-600 hover:bg-emerald-700 text-white transition-colors cursor-pointer"
      >
        {isEnglish ? "Got it" : "Entendido"}
      </button>
    </div>
  </div>
</div>

<!-- Embedded Concept Data for Client Scripts -->
<script id="concept-deep-dives-data" type="application/json" set:html={JSON.stringify(concepts)} />

<script>
  function setupConceptModal() {
    const modal = document.getElementById('concept-modal');
    const card = document.getElementById('concept-modal-card');
    const closeBtn = document.getElementById('concept-modal-close');
    const footerCloseBtn = document.getElementById('concept-modal-footer-close');
    
    const categoryIcon = document.getElementById('concept-modal-category-icon');
    const category = document.getElementById('concept-modal-category');
    const title = document.getElementById('concept-modal-title');
    const headline = document.getElementById('concept-modal-headline');
    
    const analogyBox = document.getElementById('concept-modal-analogy-box');
    const analogy = document.getElementById('concept-modal-analogy');
    
    const mechanism = document.getElementById('concept-modal-mechanism');
    const termsContainer = document.getElementById('concept-modal-terms-container');
    const termsList = document.getElementById('concept-modal-terms-list');
    
    const farmacy = document.getElementById('concept-modal-farmacy');
    const quoteBox = document.getElementById('concept-modal-quote-box');
    const quote = document.getElementById('concept-modal-quote');
    const lesson = document.getElementById('concept-modal-lesson');

    let conceptData: Record<string, any> = {};
    const dataScript = document.getElementById('concept-deep-dives-data');
    if (dataScript && dataScript.textContent) {
      try {
        conceptData = JSON.parse(dataScript.textContent);
      } catch (e) {
        console.error('Error parsing concept deep dives data:', e);
      }
    }

    function openModal(conceptId: string) {
      const item = conceptData[conceptId];
      if (!item || !modal || !card) return;

      if (categoryIcon) categoryIcon.textContent = item.categoryIcon || '💡';
      if (category) category.textContent = item.category || 'Concepto';
      if (title) title.textContent = item.title || '';
      if (headline) headline.textContent = item.headline || '';

      if (item.frontendAnalogy) {
        if (analogy) analogy.textContent = item.frontendAnalogy;
        analogyBox?.classList.remove('hidden');
      } else {
        analogyBox?.classList.add('hidden');
      }

      if (mechanism) mechanism.textContent = item.mechanism || '';

      if (termsList) {
        termsList.innerHTML = '';
        if (item.keyTerms && item.keyTerms.length > 0) {
          item.keyTerms.forEach((k: { term: string; explanation: string }) => {
            const cardEl = document.createElement('div');
            cardEl.className = 'p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-800 space-y-1';
            
            const titleEl = document.createElement('div');
            titleEl.className = 'text-xs font-mono font-bold text-emerald-800 dark:text-emerald-300 flex items-center gap-1.5';
            titleEl.innerHTML = `<span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0"></span><span>${k.term}</span>`;
            
            const expEl = document.createElement('div');
            expEl.className = 'text-xs text-slate-700 dark:text-slate-300 leading-relaxed pl-3';
            expEl.textContent = k.explanation;
            
            cardEl.appendChild(titleEl);
            cardEl.appendChild(expEl);
            termsList.appendChild(cardEl);
          });
          termsContainer?.classList.remove('hidden');
        } else {
          termsContainer?.classList.add('hidden');
        }
      }

      if (farmacy) farmacy.textContent = item.farmacyCase || '';

      if (item.originalQuote) {
        if (quote) quote.textContent = `"${item.originalQuote}"`;
        quoteBox?.classList.remove('hidden');
      } else {
        quoteBox?.classList.add('hidden');
      }

      if (lesson) lesson.textContent = item.architecturalLesson || '';

      modal.classList.remove('hidden');
      requestAnimationFrame(() => {
        modal.classList.remove('opacity-0');
        card.classList.remove('scale-95');
        card.classList.add('scale-100');
      });
      document.body.classList.add('overflow-hidden');
    }

    function closeModal() {
      if (!modal || !card) return;
      modal.classList.add('opacity-0');
      card.classList.remove('scale-100');
      card.classList.add('scale-95');
      setTimeout(() => {
        modal.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
      }, 200);
    }

    // Attach click listener to all concept chips
    document.querySelectorAll('.concept-chip').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const cid = btn.getAttribute('data-concept');
        if (cid) openModal(cid);
      });
    });

    closeBtn?.addEventListener('click', closeModal);
    footerCloseBtn?.addEventListener('click', closeModal);

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupConceptModal);
  } else {
    setupConceptModal();
  }
</script>
