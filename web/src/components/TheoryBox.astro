---
interface Props {
  concept: string;
  chapter?: string;
}

const { concept, chapter } = Astro.props;
---

<div class="my-6 rounded-xl border border-emerald-200 dark:border-emerald-800/60 bg-emerald-50/60 dark:bg-emerald-950/25 p-5 shadow-sm">
  <div class="flex items-center justify-between gap-2 border-b border-emerald-200/70 dark:border-emerald-800/40 pb-2.5 mb-3">
    <div class="flex items-center gap-2">
      <span class="text-emerald-700 dark:text-emerald-400 text-lg">📖</span>
      <div>
        <div class="text-[10px] uppercase tracking-wider font-bold text-emerald-800 dark:text-emerald-400 font-mono">
          Fundamentals of Software Architecture {chapter ? `· ${chapter}` : ""}
        </div>
        <h5 class="text-sm font-bold text-slate-900 dark:text-slate-100">{concept}</h5>
      </div>
    </div>
    <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-emerald-100 dark:bg-emerald-900/60 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-700 font-semibold">
      Richards & Ford
    </span>
  </div>
  <div class="text-xs sm:text-sm leading-relaxed text-slate-700 dark:text-slate-300">
    <slot />
  </div>
</div>
