---
import { ARCHCOLIDER_ADRS, ARCHCOLIDER_ADRS_EN } from '../data/archcolider-adrs';

interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const isEnglish = lang === 'en';
const adrsList = isEnglish ? ARCHCOLIDER_ADRS_EN : ARCHCOLIDER_ADRS;

const statusColors: Record<string, { bg: string; text: string; border: string }> = {
  Accepted: { bg: 'bg-emerald-100 dark:bg-emerald-950/70', text: 'text-emerald-800 dark:text-emerald-300', border: 'border-emerald-300 dark:border-emerald-700 font-bold' },
  Proposed: { bg: 'bg-sky-50 dark:bg-sky-950/40', text: 'text-sky-700 dark:text-sky-300', border: 'border-sky-300 dark:border-sky-700' },
  Declined: { bg: 'bg-rose-50 dark:bg-rose-950/40', text: 'text-rose-700 dark:text-rose-300', border: 'border-rose-300 dark:border-rose-700' },
  Draft: { bg: 'bg-stone-100 dark:bg-stone-800/80', text: 'text-stone-700 dark:text-stone-300', border: 'border-stone-300 dark:border-stone-700' },
};
---

<div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/50 p-4 sm:p-6 space-y-6 shadow-xs my-6">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200 dark:border-slate-800 pb-4">
    <div>
      <div class="flex items-center gap-2">
        <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-emerald-100 dark:bg-emerald-900/60 text-emerald-800 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-700">
          Top 1 Winner
        </span>
        <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-slate-100 font-mono">
          {isEnglish ? "Complete Compendium: ArchColider's 16 ADRs" : "Compendio Completo: Los 16 ADRs de ArchColider"}
        </h3>
      </div>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-1 leading-relaxed">
        {isEnglish 
          ? "Complete and unabridged record of all 16 architecture decisions documented in their original repository, including context, decisions, consequences, and direct GitHub source links."
          : "Registro íntegro y traducido de las 16 decisiones de arquitectura documentadas en su repositorio original, con su contexto, decisiones, consecuencias y enlaces directos a GitHub."
        }
      </p>
    </div>

    <!-- Quick action controls -->
    <div class="flex items-center gap-2 shrink-0">
      <button 
        id="expand-all-adrs" 
        type="button" 
        class="text-xs font-mono px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 transition-colors shadow-2xs cursor-pointer"
      >
        {isEnglish ? "Expand all" : "Expandir todos"}
      </button>
      <button 
        id="collapse-all-adrs" 
        type="button" 
        class="text-xs font-mono px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 transition-colors shadow-2xs cursor-pointer"
      >
        {isEnglish ? "Collapse all" : "Colapsar todos"}
      </button>
    </div>
  </div>

  <!-- Interactive Filter Toolbar -->
  <div class="flex flex-wrap items-center gap-2 pt-1 text-xs font-mono">
    <button type="button" class="adr-filter-btn px-3 py-1 rounded-md font-bold bg-emerald-600 text-white shadow-2xs transition-colors" data-filter="all">
      {isEnglish ? "All" : "Todos"} ({adrsList.length})
    </button>
    <button type="button" class="adr-filter-btn px-3 py-1 rounded-md bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors cursor-pointer" data-filter="Accepted">
      Accepted (4)
    </button>
    <button type="button" class="adr-filter-btn px-3 py-1 rounded-md bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors cursor-pointer" data-filter="Proposed">
      Proposed (10)
    </button>
    <button type="button" class="adr-filter-btn px-3 py-1 rounded-md bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors cursor-pointer" data-filter="Declined">
      Declined (1)
    </button>
    <button type="button" class="adr-filter-btn px-3 py-1 rounded-md bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors cursor-pointer" data-filter="Draft">
      Draft (1)
    </button>
  </div>

  <!-- ADR Cards List -->
  <div class="space-y-3" id="adr-container">
    {adrsList.map((adr) => {
      const colors = statusColors[adr.status] || statusColors.Proposed;
      const isAccepted = adr.status === 'Accepted';
      const cardBorder = isAccepted 
        ? "border-emerald-300/80 dark:border-emerald-700/60 bg-emerald-50/20 dark:bg-emerald-950/15" 
        : "border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900";
      const tagClasses = isAccepted
        ? "bg-emerald-100 dark:bg-emerald-950/70 text-emerald-800 dark:text-emerald-300 border-emerald-300 dark:border-emerald-700 font-bold"
        : "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border-slate-200 dark:border-slate-700";
      return (
        <details 
          class={`adr-card group rounded-xl border ${cardBorder} transition-all duration-200 shadow-2xs open:border-slate-300 dark:open:border-slate-700`} 
          data-status={adr.status}
        >
          <summary class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 p-4 cursor-pointer select-none hover:bg-slate-50/70 dark:hover:bg-slate-800/40 rounded-xl transition-colors list-none">
            <div class="flex items-center gap-3">
              <span class={`w-16 shrink-0 font-mono text-xs px-2 py-1 rounded border text-center ${tagClasses}`}>
                ADR {adr.id}
              </span>
              <div>
                <span class="font-bold text-sm sm:text-base text-slate-900 dark:text-slate-100 group-hover:text-emerald-700 dark:group-hover:text-emerald-400 transition-colors">
                  {adr.title}
                </span>
                <span class="hidden sm:inline-block text-xs font-mono text-slate-500 dark:text-slate-400 ml-2">
                  ({adr.originalTitle})
                </span>
              </div>
            </div>

            <div class="flex items-center gap-2 shrink-0 self-end sm:self-center">
              <span class="text-[11px] font-mono text-slate-600 dark:text-slate-300 hidden md:inline">
                {adr.category}
              </span>
              <span class={`px-2 py-0.5 rounded text-[11px] font-mono font-bold border ${colors.bg} ${colors.text} ${colors.border}`}>
                {adr.status}
              </span>
              <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </div>
          </summary>

          <div class="p-4 pt-2 border-t border-slate-100 dark:border-slate-800 text-xs sm:text-sm space-y-4">
            <div class="flex flex-wrap items-center gap-4 text-xs font-mono text-slate-500 border-b border-slate-100 dark:border-slate-800 pb-2">
              <span>📅 {isEnglish ? "Original date: " : "Fecha original: "}<span class="font-semibold text-slate-700 dark:text-slate-300">{adr.date}</span></span>
              <span>🏷️ {isEnglish ? "Category: " : "Categoría: "}<span class="font-semibold text-slate-700 dark:text-slate-300">{adr.category}</span></span>
              <a 
                href={adr.githubUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="text-emerald-700 dark:text-emerald-400 underline hover:text-emerald-800 flex items-center gap-1 font-semibold ml-auto"
              >
                <span>{isEnglish ? "View original file on GitHub" : "Ver archivo original en GitHub"}</span>
                <span>↗</span>
              </a>
            </div>

            <!-- Context -->
            <div class="space-y-1">
              <div class="font-mono font-bold text-xs uppercase tracking-wider text-slate-700 dark:text-slate-300">
                {isEnglish ? "Context & Problem Statement" : "Contexto"}
              </div>
              <p class="text-slate-700 dark:text-slate-300 leading-relaxed bg-slate-50 dark:bg-slate-950/60 p-3 rounded-lg border border-slate-100 dark:border-slate-800/80">
                {adr.context}
              </p>
            </div>

            <!-- Decision -->
            <div class="space-y-1">
              <div class="font-mono font-bold text-xs uppercase tracking-wider text-emerald-800 dark:text-emerald-400">
                {isEnglish ? "Decision" : "Decisión"}
              </div>
              <p class="text-slate-800 dark:text-slate-200 leading-relaxed bg-emerald-50/40 dark:bg-emerald-950/20 p-3 rounded-lg border border-emerald-200/60 dark:border-emerald-800/60 font-medium">
                {adr.decision}
              </p>
            </div>

            {adr.reason && (
              <div class="space-y-1">
                <div class="font-mono font-bold text-xs uppercase tracking-wider text-rose-700 dark:text-rose-400">
                  {isEnglish ? "Rejection Reason" : "Motivo de Rechazo (Reason)"}
                </div>
                <p class="text-rose-900 dark:text-rose-200 leading-relaxed bg-rose-50/50 dark:bg-rose-950/30 p-3 rounded-lg border border-rose-200 dark:border-rose-800">
                  {adr.reason}
                </p>
              </div>
            )}

            <!-- Consequences -->
            <div class="space-y-2">
              <div class="font-mono font-bold text-xs uppercase tracking-wider text-slate-700 dark:text-slate-300">
                {isEnglish ? "Consequences & Incurred Trade-offs" : "Consecuencias y Compromisos Asumidos"}
              </div>
              
              <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                {adr.consequences.positive && adr.consequences.positive.length > 0 && (
                  <div class="p-3 rounded-lg bg-emerald-50/30 dark:bg-emerald-950/20 border border-emerald-200/50 dark:border-emerald-900/50">
                    <span class="font-bold font-mono text-xs text-emerald-800 dark:text-emerald-300 flex items-center gap-1 mb-1.5">
                      <span>✓</span> {isEnglish ? "Positive" : "Positivas"}
                    </span>
                    <ul class="list-disc pl-4 space-y-1 text-slate-700 dark:text-slate-300 text-xs">
                      {adr.consequences.positive.map((item: string) => <li>{item}</li>)}
                    </ul>
                  </div>
                )}

                {adr.consequences.negative && adr.consequences.negative.length > 0 && (
                  <div class="p-3 rounded-lg bg-rose-50/30 dark:bg-rose-950/20 border border-rose-200/50 dark:border-rose-900/50">
                    <span class="font-bold font-mono text-xs text-rose-800 dark:text-rose-300 flex items-center gap-1 mb-1.5">
                      <span>✕</span> {isEnglish ? "Negative (Trade-offs)" : "Negativas (Trade-offs)"}
                    </span>
                    <ul class="list-disc pl-4 space-y-1 text-slate-700 dark:text-slate-300 text-xs">
                      {adr.consequences.negative.map((item: string) => <li>{item}</li>)}
                    </ul>
                  </div>
                )}

                {adr.consequences.risks && adr.consequences.risks.length > 0 && (
                  <div class="p-3 rounded-lg bg-amber-50/40 dark:bg-amber-950/20 border border-amber-200/50 dark:border-amber-900/50 col-span-1 md:col-span-2">
                    <span class="font-bold font-mono text-xs text-amber-800 dark:text-amber-300 flex items-center gap-1 mb-1.5">
                      <span>⚠️</span> {isEnglish ? "Identified Risks" : "Riesgos Identificados"}
                    </span>
                    <ul class="list-disc pl-4 space-y-1 text-slate-700 dark:text-slate-300 text-xs">
                      {adr.consequences.risks.map((item: string) => <li>{item}</li>)}
                    </ul>
                  </div>
                )}
              </div>
            </div>
          </div>
        </details>
      );
    })}
  </div>
</div>

<script>
  const filterButtons = document.querySelectorAll('.adr-filter-btn');
  const adrCards = document.querySelectorAll('.adr-card');
  const expandAllBtn = document.getElementById('expand-all-adrs');
  const collapseAllBtn = document.getElementById('collapse-all-adrs');

  filterButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');
      filterButtons.forEach(b => {
        b.classList.remove('bg-emerald-600', 'text-white', 'shadow-2xs');
        b.classList.add('bg-white', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300', 'border', 'border-slate-200', 'dark:border-slate-700');
      });
      btn.classList.add('bg-emerald-600', 'text-white', 'shadow-2xs');
      btn.classList.remove('bg-white', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300', 'border', 'border-slate-200', 'dark:border-slate-700');

      adrCards.forEach(card => {
        const cardStatus = card.getAttribute('data-status');
        if (filter === 'all' || cardStatus === filter) {
          (card as HTMLElement).style.display = 'block';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });

  expandAllBtn?.addEventListener('click', () => {
    adrCards.forEach(card => {
      (card as HTMLDetailsElement).open = true;
    });
  });

  collapseAllBtn?.addEventListener('click', () => {
    adrCards.forEach(card => {
      (card as HTMLDetailsElement).open = false;
    });
  });
</script>
