---
interface Props {
  rank: 2 | 3;
  team: string;
  title: string;
  githubUrl?: string;
  githubLineRange?: string;
  lang?: 'es' | 'en';
}

const { rank, team, title, githubUrl, githubLineRange, lang = 'es' } = Astro.props;
const isEnglish = lang === 'en';

const isSilver = rank === 2;
const cardStyles = isSilver 
  ? "border-slate-300/80 dark:border-slate-700/80 bg-slate-50/90 dark:bg-slate-900/80 text-slate-800 dark:text-slate-200 shadow-sm" 
  : "border-slate-300/80 dark:border-slate-700/80 bg-slate-50/70 dark:bg-slate-900/70 text-slate-800 dark:text-slate-200 shadow-sm";
const badgeStyles = isSilver 
  ? "bg-slate-200/90 dark:bg-slate-800 text-slate-800 dark:text-slate-300 border-slate-300 dark:border-slate-600 font-semibold" 
  : "bg-stone-200/80 dark:bg-stone-800 text-stone-800 dark:text-stone-300 border-stone-300 dark:border-stone-700 font-semibold";
const headerBorder = "border-slate-200 dark:border-slate-800";
const medalIcon = isSilver ? "🥈" : "🥉";
const medalLabel = isSilver 
  ? (isEnglish ? "2nd Place (Finalist)" : "2° Lugar (Finalista)") 
  : (isEnglish ? "3rd Place (Finalist)" : "3° Lugar (Finalista)");
const viewOnGithubLabel = isEnglish ? "View on GitHub" : "Ver en GitHub";
---

<div class={`my-8 rounded-xl border p-6 transition-all ${cardStyles}`}>
  <div class={`flex flex-wrap items-center justify-between gap-3 border-b ${headerBorder} pb-3 mb-4`}>
    <div class="flex items-center gap-3">
      <span class="text-2xl drop-shadow-sm" role="img" aria-label={medalLabel}>{medalIcon}</span>
      <div>
        <div class="flex items-center gap-2 flex-wrap">
          <span class={`text-[10px] uppercase tracking-wider px-2 py-0.5 rounded-full border whitespace-nowrap inline-block ${badgeStyles}`}>
            {medalLabel}
          </span>
          <span class="text-xs font-bold text-slate-600 dark:text-slate-400 font-mono whitespace-nowrap">{team}</span>
        </div>
        <h4 class="text-base sm:text-lg font-bold text-slate-900 dark:text-slate-100 tracking-tight mt-1">{title}</h4>
      </div>
    </div>
    {githubUrl && (
      <a 
        href={githubUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-mono font-medium rounded-lg border transition-all bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:text-slate-900 dark:hover:text-white hover:border-slate-400 dark:hover:border-slate-600 border-slate-300 dark:border-slate-700 shadow-sm"
      >
        <svg class="w-3.5 h-3.5 text-slate-700 dark:text-slate-300" viewBox="0 0 24 24" fill="currentColor">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        <span>{viewOnGithubLabel}</span>
        {githubLineRange && <span class="text-emerald-700 dark:text-emerald-400 font-semibold">({githubLineRange})</span>}
      </a>
    )}
  </div>
  <div class="text-sm leading-relaxed text-slate-700 dark:text-slate-300 space-y-2">
    <slot />
  </div>
</div>
